# Settings a live deployment needs. Copy these into the hosting environment — Render's
# Environment tab, Azure's Configuration, or IIS environment variables — and fill in the
# values marked CHANGE-ME. Do not commit a filled-in copy: it holds passwords.
#
# Anything required but missing stops the application on startup with a message naming it,
# so a half-configured deployment cannot quietly serve a school demo content.

# ---------------------------------------------------------------------------
# Database — the school's own SQL Server
# ---------------------------------------------------------------------------
Database__Provider=SqlServer
ConnectionStrings__DefaultConnection=Server=CHANGE-ME;Database=CmsDb;User Id=CHANGE-ME;Password=CHANGE-ME;TrustServerCertificate=True;MultipleActiveResultSets=true

# Creates every table on the first run. Nothing to run by hand.
Database__ApplyMigrationsOnStartup=true

# ---------------------------------------------------------------------------
# The console and its first administrator
# ---------------------------------------------------------------------------
# The address the console is reached at. Every other domain is treated as a school's own
# website, so this must match exactly what is typed into the browser.
Platform__Domain=CHANGE-ME.example.com
Platform__SuperAdminEmail=CHANGE-ME@example.com
Platform__SuperAdminPassword=CHANGE-ME
Platform__SuperAdminName=Platform Administrator
Platform__TenantName=Platform Console

# ---------------------------------------------------------------------------
# Uploaded photographs and documents
# ---------------------------------------------------------------------------
# S3 is the safe choice: files survive every deployment and need no disk.
Storage__Provider=S3
Aws__BucketName=CHANGE-ME
Aws__Region=ap-south-1
Aws__AccessKey=CHANGE-ME
Aws__SecretKey=CHANGE-ME

# The bucket stays private by default: uploaded files are served through this application, so
# nothing has to be made readable by the world. Set PublicBucket=true only if the bucket really
# does allow anonymous reads — it saves a hop, and is wrong in a way that shows as broken images.
# Aws__PublicBucket=false

# A folder every file is written under. Needed when the bucket is shared with another system, or
# when the AWS account only grants write access to one folder rather than the whole bucket — in
# which case this must match that folder exactly, or every upload is refused.
# Aws__FolderPath=WebSiteData

# Set this to a CloudFront address to serve images from the CDN instead of through this
# application. Requires the objects to be reachable by CloudFront.
# Aws__PublicBaseUrl=https://dxxxxxxxx.cloudfront.net

# Staying on local disk instead? Then a persistent disk MUST be mounted at /data, or every
# uploaded photograph is lost on the next deployment.
# Storage__Provider=Local
# Storage__LocalRootPath=/data/uploads

# ---------------------------------------------------------------------------
# Email (optional)
# ---------------------------------------------------------------------------
# Without these, contact-form messages still arrive in the console's inbox; they are simply
# not emailed on.
# Email__Host=smtp.example.com
# Email__Port=587
# Email__UseSsl=true
# Email__UserName=CHANGE-ME
# Email__Password=CHANGE-ME
# Email__FromAddress=noreply@example.com
# Email__FromName=School Name

# ---------------------------------------------------------------------------
# The API (only if it is exposed)
# ---------------------------------------------------------------------------
# At least 32 characters, and not the one from this repository.
Jwt__Key=CHANGE-ME-to-a-long-random-string-of-at-least-32-characters
Jwt__Issuer=Cms.Api
Jwt__Audience=Cms.Clients

# ---------------------------------------------------------------------------
# Already correct in the image — listed so nothing looks missing
# ---------------------------------------------------------------------------
# ASPNETCORE_ENVIRONMENT=Production
# Proxy__TrustForwardedHeaders=true
# PublicCache__Seconds=0

# ---------------------------------------------------------------------------
# Demo workspace only — leave these out of a real deployment
# ---------------------------------------------------------------------------
# DemoMode__Enabled=true
# Seed__EnableDemoData=true
# Seed__DemoAdminPassword=CHANGE-ME
# Database__Provider=Sqlite
# ConnectionStrings__Sqlite=Data Source=/data/cms.db;Cache=Shared;Default Timeout=30
