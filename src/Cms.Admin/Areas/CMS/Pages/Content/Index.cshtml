@page
@model Cms.Admin.Areas.CMS.Pages.Content.IndexModel
@{
    ViewData["Title"] = Model.TypeLabel;
}

<div class="page-header">
    <div><div class="eyebrow">Structured content</div><h1>@Model.TypeLabel</h1><p>Manage reusable, tenant-specific @Model.Type content for APIs and website experiences.</p></div>
</div>

<div class="content-type-tabs">
    @foreach (var type in new[] { "news", "event", "person", "department", "setting", "theme" })
    {
        <a class="status-pill @(Model.Type == type ? null : "is-inactive")" asp-route-type="@type">@type</a>
    }
</div>
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="notice">@Model.StatusMessage</div> }

<div class="content-manager-layout">
    <section class="form-card">
        <div class="form-card__header"><div><span class="step-number">01</span><span><strong>@Model.TypeLabel entries</strong><small>@Model.Entries.Count configured</small></span></div></div>
        <div class="content-list">
            @foreach (var entry in Model.Entries)
            {
                <article>
                    <span><strong>@entry.Title</strong><small>@entry.Key · @(entry.IsActive ? "Published" : "Hidden")</small></span>
                    <span class="content-list__actions">
                        <a class="btn btn-secondary btn-sm" asp-route-type="@Model.Type" asp-route-edit="@entry.Id">Edit</a>
                        @if (Model.CanDelete)
                        {
                            <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this entry?');">
                                <input type="hidden" asp-for="Type" /><input type="hidden" name="id" value="@entry.Id" />
                                <button class="btn btn-secondary btn-sm">Delete</button>
                            </form>
                        }
                    </span>
                </article>
            }
        </div>
    </section>

    <section class="form-card">
        <div class="form-card__header"><div><span class="step-number">02</span><span><strong>@(Model.EditId.HasValue ? "Edit entry" : "New entry")</strong><small>Flexible structured content</small></span></div></div>
        <div class="form-card__body">
            <form method="post" asp-page-handler="Save" class="field-grid">
                <input asp-for="Type" type="hidden" /><input asp-for="EditId" type="hidden" />
                <div asp-validation-summary="All" class="validation-summary full"></div>
                <label class="field"><span>Title</span><input asp-for="Input.Title" /></label>
                <label class="field"><span>Unique key</span><input asp-for="Input.Key" placeholder="annual-day-2026" /></label>
                <label class="field full"><span>Summary</span><textarea asp-for="Input.Summary" rows="2"></textarea></label>
                <label class="field full"><span>Body</span><textarea asp-for="Input.Body" rows="7"></textarea></label>
                <label class="field full"><span>Image URL</span><input asp-for="Input.ImageUrl" /></label>
                <label class="field"><span>Publish date</span><input asp-for="Input.PublishDate" type="datetime-local" /></label>
                <label class="field"><span>Display order</span><input asp-for="Input.DisplayOrder" type="number" min="0" /></label>
                <label class="field full"><span>Additional JSON</span><textarea asp-for="Input.JsonData" rows="5" placeholder="{}"></textarea></label>
                <label class="switch-row full"><input asp-for="Input.IsActive" /><span><strong>Published</strong><small>Expose this entry through the public content API.</small></span></label>
                <div class="full form-actions"><button class="btn" type="submit">Save entry</button>@if (Model.EditId.HasValue) { <a class="btn btn-secondary" asp-route-type="@Model.Type">Cancel</a> }</div>
            </form>
        </div>
    </section>
</div>
