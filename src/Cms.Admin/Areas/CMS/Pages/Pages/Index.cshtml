@page
@model Cms.Admin.Areas.CMS.Pages.Pages.IndexModel
@{
    ViewData["Title"] = "Pages";
}

<div class="page-header">
    <div>
        <div class="eyebrow">Website content</div>
        <h1>Pages</h1>
        <p>Create database-driven pages with clean URLs, publishing controls and SEO metadata.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="notice">@Model.StatusMessage</div> }

<div class="content-manager-layout">
    <section class="form-card">
        <div class="form-card__header"><div><span class="step-number">01</span><span><strong>Existing pages</strong><small>@Model.Pages.Count page(s)</small></span></div></div>
        <div class="content-list">
            @foreach (var item in Model.Pages)
            {
                <article>
                    <span><strong>@item.Title</strong><small>/@item.Slug · @(item.IsActive ? "Published" : "Draft")</small></span>
                    <span class="content-list__actions">
                        <a class="btn btn-secondary btn-sm" asp-route-edit="@item.Id">Edit</a>
                        @if (Model.CanDelete)
                        {
                            <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this page?');">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="btn btn-secondary btn-sm" type="submit">Delete</button>
                            </form>
                        }
                    </span>
                </article>
            }
        </div>
    </section>

    <section class="form-card">
        <div class="form-card__header"><div><span class="step-number">02</span><span><strong>@(Model.EditId.HasValue ? "Edit page" : "New page")</strong><small>Content and search metadata</small></span></div></div>
        <div class="form-card__body">
            <form method="post" asp-page-handler="Save" class="field-grid">
                <input asp-for="EditId" type="hidden" />
                <div asp-validation-summary="All" class="validation-summary full"></div>
                <label class="field"><span>Title</span><input asp-for="Input.Title" /></label>
                <label class="field"><span>Slug</span><input asp-for="Input.Slug" placeholder="about-us" /></label>
                <label class="field full"><span>Excerpt</span><textarea asp-for="Input.Excerpt" rows="2"></textarea></label>
                <label class="field full"><span>Page content</span><textarea asp-for="Input.Content" rows="10"></textarea></label>
                <label class="field full"><span>Featured image URL</span><input asp-for="Input.FeaturedImageUrl" /></label>
                <label class="field"><span>SEO title</span><input asp-for="Input.MetaTitle" /></label>
                <label class="field"><span>SEO description</span><input asp-for="Input.MetaDescription" /></label>
                <label class="switch-row full"><input asp-for="Input.IsActive" type="checkbox" /><span><strong>Published</strong><small>Make this page available through the public API.</small></span></label>
                <div class="full form-actions">
                    <button class="btn" type="submit">Save page</button>
                    @if (Model.EditId.HasValue) { <a class="btn btn-secondary" asp-page="Index">Cancel</a> }
                </div>
            </form>
        </div>
    </section>
</div>
