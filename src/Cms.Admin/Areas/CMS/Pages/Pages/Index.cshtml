@page
@model Cms.Admin.Areas.CMS.Pages.Pages.IndexModel
@using Cms.Domain.Enums
@{
    ViewData["Title"] = "Pages";
}

<div class="page-header">
    <div>
        <div class="eyebrow">Website content</div>
        <h1>Pages</h1>
        <p>Edit school pages with guided forms for About, Admission, Gallery, Disclosure, Contact and more. Menus update automatically.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="notice">@Model.StatusMessage</div> }

<div class="content-manager-layout">
    <section class="form-card">
        <div class="form-card__header"><div><span class="step-number">01</span><span><strong>Assigned pages</strong><small>@Model.Pages.Count page(s)</small></span></div></div>
        <div class="content-list">
            @if (Model.Pages.Count == 0)
            {
                <div class="empty-state"><strong>No pages yet</strong><span>Assign pages from the page gallery, or create one alongside.</span></div>
            }
            @foreach (var item in Model.Pages)
            {
                <article>
                    <span><strong>@item.Title</strong><small>/@item.Slug · @item.PageType · @(item.IsActive ? "Published" : "Draft")</small></span>
                    <span class="content-list__actions">
                        <a class="btn btn-secondary btn-sm" asp-route-edit="@item.Id">Edit</a>
                        @if (Model.CanDelete)
                        {
                            <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this page?');">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="btn btn-secondary btn-sm" type="submit">Delete</button>
                            </form>
                        }
                    </span>
                </article>
            }
        </div>
    </section>

    <section class="form-card">
        <div class="form-card__header"><div><span class="step-number">02</span><span><strong>@(Model.EditId.HasValue ? "Edit page" : "New page")</strong><small>Guided content editor</small></span></div></div>
        <div class="form-card__body">
            <form method="post" asp-page-handler="Save" class="field-grid">
                <input asp-for="EditId" type="hidden" />
                <div asp-validation-summary="All" class="validation-summary full"></div>
                <label class="field"><span>Title</span><input asp-for="Input.Title" /></label>
                <label class="field"><span>Slug</span><input asp-for="Input.Slug" placeholder="about" /></label>
                <label class="field">
                    <span>Page type</span>
                    <select asp-for="Input.PageType" asp-items="Html.GetEnumSelectList<PageType>()" data-page-type></select>
                </label>
                <label class="field"><span>Template key</span><input asp-for="Input.TemplateKey" /></label>
                <label class="field full"><span>Excerpt</span><textarea asp-for="Input.Excerpt" rows="2"></textarea></label>
                <label class="field full"><span>Page content (HTML)</span><textarea asp-for="Input.Content" rows="6"></textarea></label>

                <div class="full">
                    <strong>Structured page content</strong>
                    <small>School-friendly fields for this page type. Saves as structured data for the public website.</small>
                    <div class="config-builder" data-typed-editor style="margin-top:1rem"></div>
                    <textarea asp-for="Input.JsonData" data-typed-json hidden></textarea>
                </div>

                <label class="field full">
                    <span>Featured image URL</span>
                    <div class="media-url-row">
                        <input asp-for="Input.FeaturedImageUrl" id="featured-image-url" />
                        <button type="button" class="btn btn-secondary btn-sm" data-media-picker="#featured-image-url">Browse media</button>
                    </div>
                </label>
                <label class="field"><span>Menu order</span><input asp-for="Input.MenuOrder" type="number" /></label>
                <label class="field"><span>SEO title</span><input asp-for="Input.MetaTitle" /></label>
                <label class="field full"><span>SEO description</span><input asp-for="Input.MetaDescription" /></label>
                <label class="switch-row full"><input asp-for="Input.ShowInMenu" type="checkbox" /><span><strong>Show in menu</strong><small>Primary navigation syncs from these pages.</small></span></label>
                <label class="switch-row full"><input asp-for="Input.IsActive" type="checkbox" /><span><strong>Published</strong></span></label>
                <div class="full form-actions">
                    <button class="btn" type="submit">Save page</button>
                    @if (Model.EditId.HasValue) { <a class="btn btn-secondary" asp-page="Index">Cancel</a> }
                </div>
            </form>
        </div>
    </section>
</div>
