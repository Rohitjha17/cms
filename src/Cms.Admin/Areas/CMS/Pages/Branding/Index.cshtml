@page
@model Cms.Admin.Areas.CMS.Pages.Branding.IndexModel
@using Cms.Domain.Enums
@{
    ViewData["Title"] = "Branding";
}

<div class="page-header">
    <div>
        <div class="eyebrow">School self-service</div>
        <h1>Website branding</h1>
        <p>Manage title, menu identity, logo, header image, footer, colors and contact details for the selected website.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="notice">@Model.StatusMessage</div> }

<section class="form-card">
    <div class="form-card__body">
        <form method="post" asp-page-handler="Save" class="field-grid">
            <div asp-validation-summary="All" class="validation-summary full"></div>
            <label class="field"><span>Website title</span><input asp-for="Input.Name" />
                    <small class="hint">The school's full name. Shown in the header, the footer and on Google.</small></label>
            <label class="field"><span>Site key</span><input asp-for="Input.SiteKey" readonly />
                    <small class="hint">Used in the address when one domain serves several schools. Lower case, no spaces. Leave alone unless told otherwise.</small></label>
            <label class="field">
                <span>Website type</span>
                <select asp-for="Input.WebsiteType" asp-items="Html.GetEnumSelectList<WebsiteType>()"></select>
            </label>
            <label class="field">
                <span>Home design</span>
                <select asp-for="Input.HomeVariant" asp-items="Html.GetEnumSelectList<HomeVariant>()"></select>
            </label>
            <label class="field full"><span>Tagline</span><input asp-for="Input.Tagline" />
                    <small class="hint">A short line under the name — three to five words, e.g. “We learn to serve”.</small></label>
            <label class="field full"><span>Logo URL</span>
                <div class="media-url-row">
                    <input asp-for="Input.LogoUrl" id="brand-logo-url" />
                    <small class="hint">Browse to pick your crest. A PNG with a clear background looks best. Its size and shape are set in Site settings.</small>
                    <button type="button" class="btn btn-secondary btn-sm" data-media-picker="#brand-logo-url">Browse</button>
                </div>
            </label>
            <label class="field full"><span>Favicon URL</span>
                <div class="media-url-row">
                    <input asp-for="Input.FaviconUrl" id="brand-favicon-url" />
                    <small class="hint">The small icon on the browser tab. A square picture, 64 x 64 or larger.</small>
                    <button type="button" class="btn btn-secondary btn-sm" data-media-picker="#brand-favicon-url">Browse</button>
                </div>
            </label>
            <label class="field full"><span>Header / banner image URL</span>
                <div class="media-url-row">
                    <input asp-for="Input.HeaderImageUrl" id="brand-header-url" />
                    <small class="hint">The banner behind the home page. 1920 x 1080. Only used when the Hero section has no slideshow of its own.</small>
                    <button type="button" class="btn btn-secondary btn-sm" data-media-picker="#brand-header-url">Browse</button>
                </div>
            </label>
            <label class="field"><span>Primary color</span><input asp-for="Input.PrimaryColor" />
                    <small class="hint">Your main colour — headings, menu, footer. A hex code like #0a438d.</small></label>
            <label class="field"><span>Secondary color</span><input asp-for="Input.SecondaryColor" />
                    <small class="hint">Your second colour, used for buttons and links. Button text is chosen automatically so it stays readable.</small></label>
            <label class="field full"><span>Footer text</span><textarea asp-for="Input.FooterText" rows="2"></textarea>
                    <small class="hint">The line at the very bottom, usually a copyright.</small></label>
            <label class="field full"><span>Address</span><input asp-for="Input.Address" />
                    <small class="hint">Shown in the footer and on the contact page. Also used to draw the map if no map link is set.</small></label>
            <label class="field"><span>Phone</span><input asp-for="Input.Phone" />
                    <small class="hint">Shown in the header and footer. On a phone a visitor taps it to call.</small></label>
            <label class="field"><span>Email</span><input asp-for="Input.Email" />
                    <small class="hint">Shown in the header and footer. Tapping it opens a mail window.</small></label>
            <label class="field full"><span>Map embed URL</span><input asp-for="Input.MapEmbedUrl" />
                    <small class="hint">Paste any Google Maps link — the one from your address bar, the whole &lt;iframe&gt; tag, or just the address as text. Leave blank to map the address above.</small></label>
            <label class="field full"><span>Social links JSON</span><textarea asp-for="Input.SocialLinksJson" rows="3" placeholder='{"facebook":"","instagram":"","youtube":""}'></textarea>
                    <small class="hint">For technical use. Set your social accounts in Site settings instead.</small></label>
            <div class="full form-actions"><button class="btn" type="submit">Save branding</button></div>
        </form>
    </div>
</section>
