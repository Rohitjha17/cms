@page
@using Cms.Application.DTOs.SchoolContent
@model Cms.Admin.Areas.CMS.Pages.Events.IndexModel
@{
    ViewData["Title"] = "Events";
}


<div class="page-header">
    <div>
        <div class="eyebrow">Calendar</div>
        <h1>Events</h1>
        <p>Annual day, sports meet, parent meetings and admissions open days shown on the events page.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice">@Model.StatusMessage</div>
}

<div class="content-manager-layout">
    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">01</span>
                <span><strong>Calendar</strong><small>@Model.Upcoming.Count upcoming · @Model.Past.Count past</small></span>
            </div>
        </div>
        <div class="content-list">
            @if (Model.Events.Count == 0)
            {
                <div class="empty-state">
                    <strong>No events yet</strong>
                    <span>Add the next open day or annual function so families can plan ahead.</span>
                </div>
            }

            @if (Model.Upcoming.Count > 0)
            {
                <div class="list-group-label">Upcoming</div>
                @foreach (var item in Model.Upcoming)
                {
                    <partial name="_EventRow" model="item" />
                }
            }

            @if (Model.Past.Count > 0)
            {
                <div class="list-group-label">Past</div>
                @foreach (var item in Model.Past)
                {
                    <partial name="_EventRow" model="item" />
                }
            }
        </div>
    </section>

    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">02</span>
                <span><strong>@(Model.EditId.HasValue ? "Edit event" : "New event")</strong><small>Upcoming events appear first on the website</small></span>
            </div>
        </div>
        <div class="form-card__body">
            <form method="post" asp-page-handler="Save" class="field-grid">
                <input type="hidden" asp-for="EditId" />
                <input type="hidden" asp-for="Input.Key" />
                <div asp-validation-summary="All" class="validation-summary full"></div>

                <label class="field full"><span>Event title</span><input asp-for="Input.Title" placeholder="Annual Day 2026" required /></label>

                <label class="field"><span>Starts</span><input asp-for="Input.StartsOn" type="datetime-local" required /></label>
                <label class="field"><span>Ends (optional)</span><input asp-for="Input.EndsOn" type="datetime-local" /></label>

                <label class="field full"><span>Venue</span><input asp-for="Input.Venue" placeholder="School auditorium" /></label>
                <label class="field full"><span>Summary</span><textarea asp-for="Input.Summary" rows="2"></textarea></label>
                <label class="field full"><span>Details</span><textarea asp-for="Input.Body" rows="7"></textarea></label>

                <label class="field full">
                    <span>Image</span>
                    <span class="upload-row">
                        <input asp-for="Input.ImageUrl" id="event-image-url" placeholder="/uploads/… or https://…" />
                        <button type="button" class="btn btn-secondary btn-sm" data-media-picker="#event-image-url">Browse media</button>
                    </span>
                </label>

                <label class="field"><span>Registration link</span><input asp-for="Input.RegistrationUrl" placeholder="https://…" /></label>
                <label class="field"><span>Display order</span><input asp-for="Input.DisplayOrder" type="number" min="0" /></label>

                <label class="switch-row full">
                    <input asp-for="Input.IsPublished" />
                    <span><strong>Published</strong><small>Uncheck while the date is still being confirmed.</small></span>
                </label>

                <div class="full form-actions">
                    <button class="btn" type="submit">@(Model.EditId.HasValue ? "Save changes" : "Add event")</button>
                    @if (Model.EditId.HasValue)
                    {
                        <a class="btn btn-secondary" asp-page="Index">Cancel</a>
                    }
                </div>
            </form>
        </div>
    </section>
</div>
