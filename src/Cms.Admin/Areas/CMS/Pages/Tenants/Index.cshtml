@page
@model Cms.Admin.Areas.CMS.Pages.Tenants.IndexModel
@{
    ViewData["Title"] = "Tenant management";
}

<div class="page-header">
    <div>
        <div class="eyebrow">Platform administration</div>
        <h1>Tenants and sites</h1>
        <p>Provision institutions, domains and School or College sites from one protected workspace.</p>
    </div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="notice">@Model.StatusMessage</div> }

<div class="content-manager-layout">
    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">01</span>
                <span><strong>Institutions</strong><small>@Model.Tenants.Count tenant(s)</small></span>
            </div>
        </div>
        <div class="content-list">
            @if (Model.Tenants.Count == 0)
            {
                <article>
                    <span><strong>No tenants yet</strong><small>Create the first institution using the form.</small></span>
                </article>
            }
            @foreach (var tenant in Model.Tenants)
            {
                <article>
                    <span>
                        <strong>@tenant.Name</strong>
                        <small>
                            @tenant.Code · @tenant.Sites.Count site(s) ·
                            @(tenant.Domains.Count) domain(s) · @(tenant.IsActive ? "Active" : "Disabled")
                        </small>
                    </span>
                    <a class="btn btn-secondary btn-sm" asp-route-edit="@tenant.Id">Edit</a>
                </article>
            }
        </div>
    </section>

    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">02</span>
                <span>
                    <strong>@(Model.EditId.HasValue ? "Edit tenant" : "New tenant")</strong>
                    <small>Domains and site provisioning</small>
                </span>
            </div>
        </div>
        <div class="form-card__body">
            <form method="post" asp-page-handler="Save" class="field-grid">
                <input asp-for="EditId" type="hidden" />
                <div asp-validation-summary="All" class="validation-summary full"></div>

                <label class="field">
                    <span>Institution name</span>
                    <input asp-for="Input.Name" placeholder="Cambridge High School" required />
                </label>
                <label class="field">
                    <span>Tenant code</span>
                    <input asp-for="Input.Code" placeholder="cambridge-high" required />
                    <small>Lower-case letters, numbers and hyphens.</small>
                </label>
                <label class="field full">
                    <span>Logo URL</span>
                    <input asp-for="Input.LogoUrl" placeholder="https://…" />
                </label>

                <div class="full">
                    <h3>Sites</h3>
                    <p class="hint">Exactly one site must be the default. Blank rows are ignored.</p>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Key</th>
                                <th>Type</th>
                                <th>Home design</th>
                                <th>Default</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Input.Sites.Count; i++)
                            {
                                <tr>
                                    <td><input asp-for="Input.Sites[i].Name" placeholder="Cambridge High School" /></td>
                                    <td><input asp-for="Input.Sites[i].SiteKey" placeholder="school" /></td>
                                    <td>
                                        <select asp-for="Input.Sites[i].WebsiteType">
                                            @foreach (var type in Model.WebsiteTypes)
                                            {
                                                <option value="@type">@type</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <select asp-for="Input.Sites[i].HomeVariant">
                                            @foreach (var variant in Model.HomeVariants)
                                            {
                                                <option value="@variant">@variant</option>
                                            }
                                        </select>
                                    </td>
                                    <td><input asp-for="Input.Sites[i].IsDefault" /></td>
                                    <td><input asp-for="Input.Sites[i].IsActive" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Existing addresses are shown, and posted back unchanged so saving the tenant keeps
                   them. New ones can be added here. Changing or removing one is done on the Domains
                   screen after switching to this institution from the top menu. *@
                <div class="full">
                    <h3>Domains <small class="muted">(optional)</small></h3>
                    <p class="hint">
                        The web address this institution's <strong>public website</strong> opens on, for
                        example <code>greenvalley.edu.in</code> or <code>site5.shubhsoftsolution.com</code>.
                        Point its DNS at this server first. You can leave this empty and add it later: the
                        institution's staff sign in at this same console either way. To change or remove an
                        address later, choose this institution from the menu at the top, then open Domains.
                    </p>
                    @{
                        var existingDomains = Model.Input.Domains
                            .Select((domain, index) => (Domain: domain, Index: index))
                            .Where(x => !string.IsNullOrWhiteSpace(x.Domain.DomainName))
                            .ToList();
                        var newDomains = Model.Input.Domains
                            .Select((domain, index) => (Domain: domain, Index: index))
                            .Where(x => string.IsNullOrWhiteSpace(x.Domain.DomainName))
                            .ToList();
                    }
                    @if (existingDomains.Count > 0)
                    {
                        <table class="data-table">
                            <thead>
                                <tr><th>Domain</th><th>Bound site</th><th>Primary</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var (domain, i) in existingDomains)
                                {
                                    <tr>
                                        <td>
                                            <strong>@domain.DomainName</strong>
                                            <input type="hidden" name="Input.Domains[@i].DomainName" value="@domain.DomainName" />
                                            <input type="hidden" name="Input.Domains[@i].SiteKey" value="@domain.SiteKey" />
                                            <input type="hidden" name="Input.Domains[@i].IsPrimary" value="@(domain.IsPrimary ? "true" : "false")" />
                                            <input type="hidden" name="Input.Domains[@i].IsActive" value="@(domain.IsActive ? "true" : "false")" />
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(domain.SiteKey) ? "All websites" : domain.SiteKey)</td>
                                        <td>@(domain.IsPrimary ? "Yes" : "—")</td>
                                        <td><span class="badge @(domain.IsActive ? "on" : "off")">@(domain.IsActive ? "Live" : "Disabled")</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    <table class="data-table">
                        <thead>
                            <tr><th>@(existingDomains.Count > 0 ? "Add a domain" : "Domain")</th><th>Bound site</th><th>Primary</th><th>Active</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var (domain, i) in newDomains)
                            {
                                <tr>
                                    <td><input name="Input.Domains[@i].DomainName" value="" placeholder="greenvalley.edu.in" autocomplete="off" /></td>
                                    <td>
                                        <select name="Input.Domains[@i].SiteKey">
                                            <option value="">All websites</option>
                                            @foreach (var key in Model.AvailableSiteKeys)
                                            {
                                                <option value="@key">@key</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <input type="checkbox" name="Input.Domains[@i].IsPrimary" value="true" @(domain.IsPrimary && existingDomains.Count == 0 ? "checked" : null) />
                                        <input type="hidden" name="Input.Domains[@i].IsPrimary" value="false" />
                                    </td>
                                    <td>
                                        <input type="checkbox" name="Input.Domains[@i].IsActive" value="true" checked />
                                        <input type="hidden" name="Input.Domains[@i].IsActive" value="false" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="hint">Blank rows are ignored. "All websites" opens the institution's default website, and its other websites under their key (for example <code>/college</code>).</p>
                </div>

                <p class="hint full">
                    After saving, choose this institution from the menu at the top of the console to add
                    its pages (Website templates, Page gallery), its content and its users. A school's own
                    users only ever see their own institution.
                </p>

                <label class="switch-row full">
                    <input asp-for="Input.IsActive" />
                    <span>
                        <strong>Active tenant</strong>
                        <small>Allow requests and content management for this institution.</small>
                    </span>
                </label>
                <div class="full form-actions">
                    <button class="btn" type="submit">Save tenant</button>
                    @if (Model.EditId.HasValue) { <a class="btn btn-secondary" asp-page="Index">Cancel</a> }
                </div>
            </form>
        </div>
    </section>
</div>
