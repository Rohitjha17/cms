@page
@model Cms.Admin.Areas.CMS.Pages.HomePage.IndexModel
@{
    ViewData["Title"] = "Home page";
}
@functions {
    private static string IconFor(string key) => key switch
    {
        "hero" => """<svg viewBox="0 0 24 24"><path d="M4 20h16M5 17 9 7l4 7 2-4 4 7M15 5h.01"/></svg>""",
        "statistics" => """<svg viewBox="0 0 24 24"><path d="M4 20V10h4v10M10 20V4h4v16M16 20v-7h4v7"/></svg>""",
        "gallery" => """<svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9" r="1.5"/><path d="m4 17 5-5 4 4 2-2 5 4"/></svg>""",
        "video" => """<svg viewBox="0 0 24 24"><rect x="3" y="5" width="14" height="14" rx="2"/><path d="m17 10 4-2v8l-4-2zM9 9l4 3-4 3z"/></svg>""",
        "testimonials" => """<svg viewBox="0 0 24 24"><path d="M7 17H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H9l-3 3v-3ZM16 8h4a2 2 0 0 1 2 2v8l-3-3h-2"/></svg>""",
        "contact" => """<svg viewBox="0 0 24 24"><path d="M21 10c0 6-9 12-9 12S3 16 3 10a9 9 0 1 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>""",
        "courses" or "departments" => """<svg viewBox="0 0 24 24"><path d="m3 10 9-5 9 5-9 5zM7 13v5c3 2 7 2 10 0v-5"/></svg>""",
        "announcements" or "latest_news" or "upcoming_events" => """<svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM8 2v6M16 2v6M4 10h16M8 14h3M8 17h6"/></svg>""",
        "principal" or "chairman" => """<svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c.7-5 3.4-7 8-7s7.3 2 8 7"/></svg>""",
        "partners" => """<svg viewBox="0 0 24 24"><path d="M8 12 4 8l4-4 4 4M16 12l4 4-4 4-4-4M8 12l4 4 4-4-4-4z"/></svg>""",
        _ => """<svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM8 9h8M8 13h8M8 17h5"/></svg>"""
    };
}

<div class="page-header">
    <div>
        <div class="eyebrow">Website experience</div>
        <h1>Home page composition</h1>
        <p>Shape the complete public experience for <strong>@Model.SiteName</strong>. Arrange sections, manage visibility and keep every story on-brand.</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn-secondary" asp-page="Preview" target="_blank">
            <svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
            Live preview
        </a>
        <a class="btn" asp-page="Create">
            <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
            Add section
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="notice">
        <svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg>
        @Model.StatusMessage
    </div>
}

<div class="metric-grid">
    <article class="metric-card">
        <div class="metric-card__top">
            <span class="metric-card__icon"><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM8 9h8M8 13h8M8 17h5"/></svg></span>
        </div>
        <strong class="metric-card__value">@Model.Sections.Count</strong>
        <span class="metric-card__label">Total sections</span>
    </article>
    <article class="metric-card">
        <div class="metric-card__top">
            <span class="metric-card__icon success"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg></span>
        </div>
        <strong class="metric-card__value">@Model.ActiveCount</strong>
        <span class="metric-card__label">Published sections</span>
    </article>
    <article class="metric-card">
        <div class="metric-card__top">
            <span class="metric-card__icon warning"><svg viewBox="0 0 24 24"><path d="M12 3v18M3 12h18"/></svg></span>
            <span class="progress-ring" style="--progress: @Model.CompletionPercentage%"></span>
        </div>
        <strong class="metric-card__value">@Model.CompletionPercentage%</strong>
        <span class="metric-card__label">Content readiness</span>
    </article>
    <article class="metric-card">
        <div class="metric-card__top">
            <span class="metric-card__icon neutral"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
        </div>
        <strong class="metric-card__value">@(Model.LastUpdated?.ToString("dd MMM") ?? "—")</strong>
        <span class="metric-card__label">Last content change</span>
    </article>
</div>

<div class="toolbar">
    <label class="search-box">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        <input data-section-search type="search" placeholder="Find a section…" autocomplete="off" />
    </label>
    <select data-section-status aria-label="Filter section status">
        <option value="all">All statuses</option>
        <option value="active">Published</option>
        <option value="inactive">Hidden</option>
    </select>
    <span class="toolbar__meta" data-section-count>@Model.Sections.Count sections</span>
</div>

<form method="post" asp-page-handler="Reorder" class="reorder-form" data-reorder-form>
    <input type="hidden" name="orderedKeys" data-ordered-keys />
    <div class="reorder-toolbar" data-reorder-toolbar hidden>
        <span>Section order changed</span>
        <button class="btn btn-sm" type="submit">Save order</button>
    </div>
</form>

<div class="section-list" data-sortable-sections>
    @foreach (var item in Model.Sections)
    {
        var hasContent = !string.IsNullOrWhiteSpace(item.Description)
            || !string.IsNullOrWhiteSpace(item.ImageUrl)
            || !string.IsNullOrWhiteSpace(item.JsonData);
        <article class="section-card"
                 data-section-card
                 data-section-key="@item.SectionKey"
                 draggable="true"
                 data-status="@(item.IsActive ? "active" : "inactive")"
                 data-search="@($"{item.Title} {item.SectionKey} {item.SubTitle}".ToLowerInvariant())">
            <div class="drag-handle" title="Drag to change order">
                <svg viewBox="0 0 24 24"><circle cx="9" cy="6" r=".5"/><circle cx="15" cy="6" r=".5"/><circle cx="9" cy="12" r=".5"/><circle cx="15" cy="12" r=".5"/><circle cx="9" cy="18" r=".5"/><circle cx="15" cy="18" r=".5"/></svg>
            </div>
            <span class="section-icon">@Html.Raw(IconFor(item.SectionKey))</span>
            <div class="section-card__identity">
                <strong>@item.Title</strong>
                <small>@item.SectionKey · Position @item.DisplayOrder</small>
            </div>
            <div class="section-card__content">
                <span>@(item.SubTitle ?? item.Description?.Replace("<p>", "").Replace("</p>", "") ?? "No supporting copy added yet")</span>
                <span class="content-health @(hasContent ? null : "is-draft")">@(hasContent ? "Content configured" : "Needs content")</span>
            </div>
            <div class="section-card__status">
                <form method="post" asp-page-handler="Toggle">
                    <input type="hidden" name="sectionKey" value="@item.SectionKey" />
                    <input type="hidden" name="isActive" value="@(!item.IsActive)" />
                    <button type="submit" class="status-pill @(item.IsActive ? null : "is-inactive")">
                        @(item.IsActive ? "Published" : "Hidden")
                    </button>
                </form>
            </div>
            <div class="section-actions">
                <form method="post" asp-page-handler="Move">
                    <input type="hidden" name="sectionKey" value="@item.SectionKey" />
                    <input type="hidden" name="direction" value="up" />
                    <button class="action-button" type="submit" title="Move up">
                        <svg viewBox="0 0 24 24"><path d="m7 14 5-5 5 5"/></svg>
                    </button>
                </form>
                <form method="post" asp-page-handler="Move">
                    <input type="hidden" name="sectionKey" value="@item.SectionKey" />
                    <input type="hidden" name="direction" value="down" />
                    <button class="action-button" type="submit" title="Move down">
                        <svg viewBox="0 0 24 24"><path d="m7 10 5 5 5-5"/></svg>
                    </button>
                </form>
                <a class="action-button" asp-page="Edit" asp-route-sectionKey="@item.SectionKey" title="Edit section">
                    <svg viewBox="0 0 24 24"><path d="m4 20 4.5-1 10-10-3.5-3.5-10 10zM13.5 7l3.5 3.5"/></svg>
                </a>
            </div>
        </article>
    }
    <div class="section-empty" data-section-empty hidden>
        <strong>No sections match your filters</strong>
        <p>Try another search term or status.</p>
    </div>
</div>
