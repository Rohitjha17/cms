@page
@using Cms.Application.DTOs.SchoolContent
@model Cms.Admin.Areas.CMS.Pages.News.IndexModel
@{
    ViewData["Title"] = "News and notices";
}

<div class="page-header">
    <div>
        <div class="eyebrow">Announcements</div>
        <h1>News and notices</h1>
        <p>Publish circulars, notices and school news. Featured items lead the public news page.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice">@Model.StatusMessage</div>
}

<div class="content-manager-layout">
    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">01</span>
                <span><strong>Published items</strong><small>@Model.Articles.Count item(s), newest first</small></span>
            </div>
        </div>
        <div class="content-list">
            @if (Model.Articles.Count == 0)
            {
                <div class="empty-state">
                    <strong>Nothing published yet</strong>
                    <span>Add a notice or circular and it appears on the website immediately.</span>
                </div>
            }
            @foreach (var article in Model.Articles)
            {
                <article>
                    <span class="content-list__text">
                        <strong>
                            @article.Headline
                            @if (article.IsFeatured)
                            {
                                <span class="chip chip--accent">Featured</span>
                            }
                        </strong>
                        <small>
                            @article.Category
                            @if (article.PublishDate.HasValue)
                            {
                                <text> · @article.PublishDate.Value.ToString("d MMM yyyy")</text>
                            }
                            · @(article.IsPublished ? "Published" : "Hidden")
                            @if (!string.IsNullOrWhiteSpace(article.AttachmentUrl))
                            {
                                <text> · PDF attached</text>
                            }
                        </small>
                    </span>
                    <span class="content-list__actions">
                        <a class="btn btn-secondary btn-sm" asp-route-edit="@article.Id">Edit</a>
                        @if (Model.CanDelete)
                        {
                            <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this item?');">
                                <input type="hidden" name="id" value="@article.Id" />
                                <button class="btn btn-secondary btn-sm" type="submit">Delete</button>
                            </form>
                        }
                    </span>
                </article>
            }
        </div>
    </section>

    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">02</span>
                <span><strong>@(Model.EditId.HasValue ? "Edit item" : "New item")</strong><small>Notices can carry a downloadable circular</small></span>
            </div>
        </div>
        <div class="form-card__body">
            <form method="post" asp-page-handler="Save" class="field-grid">
                <input type="hidden" asp-for="EditId" />
                <input type="hidden" asp-for="Input.Key" />
                <div asp-validation-summary="All" class="validation-summary full"></div>

                <label class="field full"><span>Headline</span><input asp-for="Input.Headline" placeholder="Winter break circular" required /></label>

                <label class="field">
                    <span>Category</span>
                    <select asp-for="Input.Category" asp-items="Html.GetEnumSelectList<NewsCategory>()"></select>
                </label>
                <label class="field"><span>Publish date</span><input asp-for="Input.PublishDate" type="datetime-local" /></label>

                <label class="field full"><span>Summary</span><textarea asp-for="Input.Summary" rows="2" placeholder="One or two lines shown in the listing."></textarea></label>
                <label class="field full"><span>Full text</span><textarea asp-for="Input.Body" rows="8"></textarea></label>

                <label class="field full">
                    <span>Image</span>
                    <span class="upload-row">
                        <input asp-for="Input.ImageUrl" id="news-image-url" placeholder="/uploads/… or https://…" />
                        <button type="button" class="btn btn-secondary btn-sm" data-media-picker="#news-image-url">Browse media</button>
                    </span>
                </label>

                <label class="field full">
                    <span>Attachment (PDF)</span>
                    <span class="upload-row">
                        <input asp-for="Input.AttachmentUrl" id="news-attachment-url" placeholder="/uploads/… or https://…" />
                        <button type="button" class="btn btn-secondary btn-sm" data-media-picker="#news-attachment-url">Browse media</button>
                    </span>
                </label>

                <label class="field"><span>Display order</span><input asp-for="Input.DisplayOrder" type="number" min="0" /></label>

                <label class="switch-row full">
                    <input asp-for="Input.IsFeatured" />
                    <span><strong>Feature this item</strong><small>Featured items are pinned to the top of the news page.</small></span>
                </label>

                <label class="switch-row full">
                    <input asp-for="Input.IsPublished" />
                    <span><strong>Published</strong><small>Uncheck to draft this item without showing it on the website.</small></span>
                </label>

                <div class="full form-actions">
                    <button class="btn" type="submit">@(Model.EditId.HasValue ? "Save changes" : "Publish")</button>
                    @if (Model.EditId.HasValue)
                    {
                        <a class="btn btn-secondary" asp-page="Index">Cancel</a>
                    }
                </div>
            </form>
        </div>
    </section>
</div>
