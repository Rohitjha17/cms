@page
@using Cms.Application.DTOs.SchoolContent
@model Cms.Admin.Areas.CMS.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Site settings";
}

<div class="page-header">
    <div>
        <div class="eyebrow">Configuration</div>
        <h1>Site settings</h1>
        <p>
            Operational details the school changes through the year. Logo, colours, address and map
            live under <a asp-page="/Branding/Index">Branding</a>.
        </p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice">@Model.StatusMessage</div>
}

<form method="post" class="settings-stack">
    <div asp-validation-summary="All" class="validation-summary"></div>

    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">01</span>
                <span><strong>Announcement bar</strong><small>A single line shown across the top of every page</small></span>
            </div>
        </div>
        <div class="form-card__body">
            <div class="field-grid">
                <label class="field full">
                    <span>Notice text</span>
                    <input asp-for="Input.NoticeTicker" placeholder="Admissions open 2027–28 | Results out on 12 May | Apply online" />
                    <small class="hint">Leave blank to hide the bar. Separate several notices with <code>|</code> and each is shown in turn.</small>
                </label>
                <label class="switch-row full">
                    <input asp-for="Input.NoticeTickerScrolls" type="checkbox" />
                    <span><strong>Scroll the text across the bar</strong><small>Moves continuously, and pauses when a visitor hovers over it. Still text is easier to read — use this only when the notice matters more than the rest of the page.</small></span>
                </label>
                <label class="field">
                    <span>Label</span>
                    <input asp-for="Input.NoticeLabel" placeholder="NOTICE" />
                    <small class="hint">A short word at the head of the strip, in the accent colour. Leave blank for none.</small>
                </label>

                <label class="field">
                    <span>Copies on the strip</span>
                    <select asp-for="Input.NoticeTickerRepeat">
                        <option value="1">One — a single copy crossing, with a gap behind it</option>
                        <option value="2">Two</option>
                        <option value="3">Three</option>
                        <option value="0">Fill the strip — as many as it takes</option>
                    </select>
                    <small class="hint">A short notice reads best as one copy. A long one is better filling the strip, or a gap opens in the middle of it.</small>
                </label>

                <label class="field">
                    <span>Seconds for one pass</span>
                    <input asp-for="Input.NoticeTickerSeconds" type="number" min="0" max="120" placeholder="26" />
                    <small class="hint">0 keeps the default pace. Higher is slower — a long notice needs 40–60, a short one reads well at 15–20.</small>
                </label>
            </div>
        </div>
    </section>

    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">02</span>
                <span><strong>Admissions</strong><small>Drives the admissions call-to-action on the website</small></span>
            </div>
        </div>
        <div class="form-card__body">
            <div class="field-grid">
                <label class="field">
                    <span>Status</span>
                    <select asp-for="Input.AdmissionStatus" asp-items="Html.GetEnumSelectList<AdmissionStatus>()"></select>
                </label>
                <label class="field"><span>Enquiry phone</span><input asp-for="Input.AdmissionsPhone" placeholder="+91 98765 43210" /></label>

                <label class="field"><span>Enquiry email</span><input asp-for="Input.AdmissionsEmail" type="email" placeholder="admissions@school.edu" /></label>
                <label class="field"><span>Office hours</span><input asp-for="Input.OfficeHours" placeholder="Mon–Sat, 9:00–15:00" /></label>

                <label class="field full">
                    <span>Prospectus / brochure</span>
                    <span class="upload-row">
                        <input asp-for="Input.BrochureUrl" id="settings-brochure-url" placeholder="/uploads/… or https://…" />
                        <button type="button" class="btn btn-secondary btn-sm" data-media-picker="#settings-brochure-url">Browse media</button>
                    </span>
                </label>

                <label class="field full"><span>Online application link</span><input asp-for="Input.ApplicationUrl" placeholder="https://apply.school.edu" /></label>
            </div>
        </div>
    </section>

    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">03</span>
                <span><strong>Social and messaging</strong><small>Shown in the website footer</small></span>
            </div>
        </div>
        <div class="form-card__body">
            <div class="field-grid">
                <label class="field"><span>WhatsApp number</span><input asp-for="Input.WhatsAppNumber" placeholder="+919876543210" /></label>
                <label class="field"><span>Facebook</span><input asp-for="Input.Facebook" placeholder="https://facebook.com/…" /></label>
                <label class="field"><span>Instagram</span><input asp-for="Input.Instagram" placeholder="https://instagram.com/…" /></label>
                <label class="field"><span>YouTube</span><input asp-for="Input.YouTube" placeholder="https://youtube.com/@@…" /></label>
                <label class="field"><span>X / Twitter</span><input asp-for="Input.Twitter" placeholder="https://x.com/…" /></label>
                <label class="field"><span>LinkedIn</span><input asp-for="Input.LinkedIn" placeholder="https://linkedin.com/school/…" /></label>
            </div>
        </div>
    </section>

    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">04</span>
                <span><strong>Appearance and motion</strong><small>Applies to every design</small></span>
            </div>
        </div>
        <div class="form-card__body">
            <div class="field-grid">
                <label class="field">
                    <span>Logo height (pixels)</span>
                    <input asp-for="Input.LogoHeight" type="number" min="0" max="160" placeholder="46" />
                    <small class="hint">0 keeps the design’s own size. 46 is the default; 80–110 suits a tall crest.</small>
                </label>
                <label class="switch-row full">
                    <input asp-for="Input.ScrollAnimations" type="checkbox" />
                    <span><strong>Fade sections in as the visitor scrolls</strong><small>Turn off for a completely still page. Visitors who ask their device for reduced motion never see the effect either way.</small></span>
                </label>

                <label class="field">
                    <span>Notice bar colour</span>
                    <input asp-for="Input.NoticeBarColor" placeholder="#c0392b" />
                    <small class="hint">Leave blank to use the brand colour. Red usually suits an admissions strip better.</small>
                </label>

                <label class="field">
                    <span>Notice bar style</span>
                    <select asp-for="Input.NoticeBarStyle">
                        <option value="">The design's own</option>
                        <option value="solid">Solid</option>
                        <option value="gradient">Gradient</option>
                        <option value="dark">Dark</option>
                        <option value="outline">Outline</option>
                    </select>
                </label>

                <label class="switch-row full">
                    <input asp-for="Input.HeroPlainImages" type="checkbox" />
                    <span><strong>Banner pictures carry their own text</strong><small>Shows each banner whole, with no heading, buttons or shading printed over it. Use this when your banners are finished artwork.</small></span>
                </label>

                <label class="switch-row full">
                    <input asp-for="Input.HeaderContact" type="checkbox" />
                    <span><strong>Phone and email in the header</strong><small>Shown with icons beside the logo, as "Call us" and "Mail us". Hidden on narrow screens.</small></span>
                </label>

                <label class="field"><span>Header button</span><input asp-for="Input.HeaderCtaText" placeholder="Admission enquiry" /></label>
                <label class="field"><span>Header button links to</span><input asp-for="Input.HeaderCtaLink" placeholder="/admission" /></label>

                <label class="field">
                    <span>Button colour</span>
                    <input asp-for="Input.ButtonColor" placeholder="#c0392b" />
                    <small class="hint">The buttons only. Leave blank to use the brand colour — until now a louder button meant repainting the whole site.</small>
                </label>

                <label class="field">
                    <span>Button style</span>
                    <select asp-for="Input.ButtonStyle">
                        <option value="">The design's own</option>
                        <option value="solid">Solid</option>
                        <option value="outline">Outline</option>
                        <option value="soft">Soft</option>
                        <option value="gradient">Gradient</option>
                    </select>
                </label>

                <label class="field">
                    <span>Button shape</span>
                    <select asp-for="Input.ButtonShape">
                        <option value="">The design's own</option>
                        <option value="rounded">Rounded</option>
                        <option value="pill">Pill</option>
                        <option value="square">Square</option>
                    </select>
                </label>

                <label class="field">
                    <span>Button hover effect</span>
                    <select asp-for="Input.ButtonHover">
                        <option value="">The design's own</option>
                        <option value="lift">Lift</option>
                        <option value="fill">Colour fills in</option>
                        <option value="glow">Glow</option>
                        <option value="slide">Light sweep</option>
                    </select>
                </label>

                <label class="field">
                    <span>Card hover effect</span>
                    <select asp-for="Input.CardHover">
                        <option value="">The design's own</option>
                        <option value="lift">Lift</option>
                        <option value="zoom">Zoom</option>
                        <option value="glow">Glow</option>
                        <option value="tilt">Tilt</option>
                    </select>
                    <small class="hint">Applies to news, events, staff and gallery cards.</small>
                </label>

                <label class="field">
                    <span>Picture hover effect</span>
                    <select asp-for="Input.ImageHover">
                        <option value="">The design's own</option>
                        <option value="zoom">Zoom</option>
                        <option value="lift">Lift</option>
                        <option value="tint">Richer colour</option>
                    </select>
                    <small class="hint">Applies to pictures inside cards and the gallery.</small>
                </label>

                <label class="field">
                    <span>Link hover effect</span>
                    <select asp-for="Input.LinkHover">
                        <option value="">The design's own</option>
                        <option value="underline">Underline</option>
                        <option value="color">Change colour</option>
                    </select>
                    <small class="hint">Links inside body copy only — never the menu or a button.</small>
                </label>

                <label class="field">
                    <span>Hover colour</span>
                    <input asp-for="Input.HoverColor" placeholder="#c9a227" />
                    <small class="hint">Used by the glow, fill and link-colour effects. Leave blank to use the accent colour.</small>
                </label>

                <label class="field">
                    <span>Default section entrance</span>
                    <select asp-for="Input.SectionAnimation">
                        <option value="">The design's own</option>
                        <option value="fade">Fade only</option>
                        <option value="fade-down">Fade down</option>
                        <option value="zoom">Zoom in</option>
                        <option value="slide-left">Slide from left</option>
                        <option value="slide-right">Slide from right</option>
                        <option value="rise">Rise up</option>
                        <option value="blur">Sharpen into focus</option>
                        <option value="none">No animation</option>
                    </select>
                    <small class="hint">Used by every section that has not chosen its own, so a consistent site takes one setting rather than twenty-three.</small>
                </label>

                <label class="field">
                    <span>Default section background</span>
                    <select asp-for="Input.SectionPattern">
                        <option value="">None</option>
                        <option value="dots">Dots</option>
                        <option value="grid">Grid</option>
                        <option value="diagonal">Diagonal lines</option>
                        <option value="rings">Rings</option>
                        <option value="waves">Waves</option>
                        <option value="drift">Drifting dots (moving)</option>
                        <option value="bubbles">Rising bubbles (moving)</option>
                        <option value="shimmer">Shimmer sweep (moving)</option>
                        <option value="twinkle">Twinkling stars (moving)</option>
                    </select>
                    <small class="hint">A section with its own background is never overruled by this.</small>
                </label>
            </div>
        </div>
    </section>

    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">05</span>
                <span><strong>Opening popup</strong><small>A poster, an enquiry form, or both — shown when the website opens</small></span>
            </div>
        </div>
        <div class="form-card__body">
            <div class="field-grid">
                <label class="switch-row full">
                    <input asp-for="Input.PopupEnabled" type="checkbox" />
                    <span><strong>Show the popup</strong><small>Nothing appears until there is a poster or the form is switched on.</small></span>
                </label>

                <label class="field full">
                    <span>Poster images</span>
                    <span class="upload-row upload-row--stacked">
                        <textarea asp-for="Input.PopupImageUrl" id="settings-popup-image" data-picker-append rows="4"
                                  placeholder="/uploads/admissions.jpg&#10;/uploads/results.jpg&#10;/uploads/open-day.jpg"></textarea>
                        <button type="button" class="btn btn-secondary btn-sm" data-media-picker="#settings-popup-image">Browse media</button>
                    </span>
                    <small class="hint">One address per line, as many as you like. Browse adds to the list rather than replacing it.</small>
                </label>

                <label class="field">
                    <span>Seconds on each poster</span>
                    <input asp-for="Input.PopupSlideSeconds" type="number" min="0" max="60" placeholder="3" />
                    <small class="hint">0 leaves the first poster up. Three seconds suits two or three posters.</small>
                </label>

                <label class="field">
                    <span>Close by itself after (seconds)</span>
                    <input asp-for="Input.PopupAutoCloseSeconds" type="number" min="0" max="120" placeholder="0" />
                    <small class="hint">0 waits for the visitor. Never applies when the popup carries a form — closing on someone mid-answer throws it away.</small>
                </label>

                <label class="field"><span>Heading</span><input asp-for="Input.PopupHeading" placeholder="Admissions open 2027–28" /></label>
                <label class="field"><span>Poster links to</span><input asp-for="Input.PopupLinkUrl" placeholder="/admissions" /></label>

                <label class="switch-row full">
                    <input asp-for="Input.PopupShowEnquiryForm" type="checkbox" />
                    <span><strong>Add an enquiry form beside the poster</strong><small>Enquiries arrive in the Contact inbox, same as the contact page.</small></span>
                </label>

                <label class="field full"><span>Form heading</span><input asp-for="Input.PopupFormHeading" placeholder="Request a callback" /></label>

                <label class="field full">
                    <span>Enquiry types</span>
                    <textarea asp-for="Input.EnquiryTypes" rows="4" placeholder="Admission enquiry&#10;General enquiry&#10;Job application&#10;Feedback"></textarea>
                    <small class="hint">One per line. Adds a chooser to the contact form and this popup, and the choice is saved with the enquiry. Leave blank for a plain subject box.</small>
                </label>

                <label class="switch-row full">
                    <input asp-for="Input.PopupOncePerVisit" type="checkbox" />
                    <span><strong>Show once per visit</strong><small>Off — the default — opens it on every page load, so a visitor who reloads finds it there. On shows it once and then leaves them alone.</small></span>
                </label>
            </div>
        </div>
    </section>

    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">06</span>
                <span><strong>Hero slideshow</strong><small>The pictures at the top of the home page, on every design</small></span>
            </div>
        </div>
        <div class="form-card__body">
            <div class="field-grid">
                <label class="field">
                    <span>Seconds on each picture</span>
                    <input asp-for="Input.HeroSlideSeconds" type="number" min="0" max="60" placeholder="6" />
                    <small class="hint">0 uses six seconds. The hero's own setting, if one was entered under Home page, wins over this.</small>
                </label>
                <label class="switch-row full">
                    <input asp-for="Input.HeroShowControls" type="checkbox" />
                    <span><strong>Show arrows and dots</strong><small>Turn off for a slideshow that runs on its own. Add the pictures under Home page → Hero Banner.</small></span>
                </label>
            </div>
        </div>
    </section>

    <div class="form-actions form-actions--sticky">
        <button class="btn" type="submit">Save site settings</button>
        <span class="hint">Changes appear on the public website immediately.</span>
    </div>
</form>
