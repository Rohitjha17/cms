@page
@using Cms.Application.DTOs.SchoolContent
@model Cms.Admin.Areas.CMS.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Site settings";
}

<div class="page-header">
    <div>
        <div class="eyebrow">Configuration</div>
        <h1>Site settings</h1>
        <p>
            Operational details the school changes through the year. Logo, colours, address and map
            live under <a asp-page="/Branding/Index">Branding</a>.
        </p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice">@Model.StatusMessage</div>
}

<form method="post" class="settings-stack">
    <div asp-validation-summary="All" class="validation-summary"></div>

    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">01</span>
                <span><strong>Announcement bar</strong><small>A single line shown across the top of every page</small></span>
            </div>
        </div>
        <div class="form-card__body">
            <div class="field-grid">
                <label class="field full">
                    <span>Notice text</span>
                    <input asp-for="Input.NoticeTicker" placeholder="Admissions open 2027–28 | Results out on 12 May | Apply online" />
                    <small class="hint">Leave blank to hide the bar. Ek se zyada notice ke liye <code>|</code> se alag kijiye — har notice alag-alag dikhega.</small>
                </label>
                <label class="switch-row full">
                    <input asp-for="Input.NoticeTickerScrolls" type="checkbox" />
                    <span><strong>Scroll the text across the bar</strong><small>Moves continuously, and pauses when a visitor hovers over it. Still text is easier to read — use this only when the notice matters more than the rest of the page.</small></span>
                </label>
                <label class="field">
                    <span>Ek waqt mein kitni baar</span>
                    <select asp-for="Input.NoticeTickerRepeat">
                        <option value="1">Ek baar — patti par ek hi copy, peeche khaali jagah</option>
                        <option value="2">Do baar</option>
                        <option value="3">Teen baar</option>
                        <option value="0">Patti bhar jaye — jitni zaroorat ho</option>
                    </select>
                    <small class="hint">Chhoti notice ko "ek baar" par saaf dikhta hai. Lambi notice ke liye "patti bhar jaye" behtar hai, warna beech mein khaali jagah aati hai.</small>
                </label>

                <label class="field">
                    <span>Seconds for one pass</span>
                    <input asp-for="Input.NoticeTickerSeconds" type="number" min="0" max="120" placeholder="26" />
                    <small class="hint">0 keeps the default pace. Higher is slower — a long notice needs 40–60, a short one reads well at 15–20.</small>
                </label>
            </div>
        </div>
    </section>

    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">02</span>
                <span><strong>Admissions</strong><small>Drives the admissions call-to-action on the website</small></span>
            </div>
        </div>
        <div class="form-card__body">
            <div class="field-grid">
                <label class="field">
                    <span>Status</span>
                    <select asp-for="Input.AdmissionStatus" asp-items="Html.GetEnumSelectList<AdmissionStatus>()"></select>
                </label>
                <label class="field"><span>Enquiry phone</span><input asp-for="Input.AdmissionsPhone" placeholder="+91 98765 43210" /></label>

                <label class="field"><span>Enquiry email</span><input asp-for="Input.AdmissionsEmail" type="email" placeholder="admissions@school.edu" /></label>
                <label class="field"><span>Office hours</span><input asp-for="Input.OfficeHours" placeholder="Mon–Sat, 9:00–15:00" /></label>

                <label class="field full">
                    <span>Prospectus / brochure</span>
                    <span class="upload-row">
                        <input asp-for="Input.BrochureUrl" id="settings-brochure-url" placeholder="/uploads/… or https://…" />
                        <button type="button" class="btn btn-secondary btn-sm" data-media-picker="#settings-brochure-url">Browse media</button>
                    </span>
                </label>

                <label class="field full"><span>Online application link</span><input asp-for="Input.ApplicationUrl" placeholder="https://apply.school.edu" /></label>
            </div>
        </div>
    </section>

    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">03</span>
                <span><strong>Social and messaging</strong><small>Shown in the website footer</small></span>
            </div>
        </div>
        <div class="form-card__body">
            <div class="field-grid">
                <label class="field"><span>WhatsApp number</span><input asp-for="Input.WhatsAppNumber" placeholder="+919876543210" /></label>
                <label class="field"><span>Facebook</span><input asp-for="Input.Facebook" placeholder="https://facebook.com/…" /></label>
                <label class="field"><span>Instagram</span><input asp-for="Input.Instagram" placeholder="https://instagram.com/…" /></label>
                <label class="field"><span>YouTube</span><input asp-for="Input.YouTube" placeholder="https://youtube.com/@@…" /></label>
                <label class="field"><span>X / Twitter</span><input asp-for="Input.Twitter" placeholder="https://x.com/…" /></label>
                <label class="field"><span>LinkedIn</span><input asp-for="Input.LinkedIn" placeholder="https://linkedin.com/school/…" /></label>
            </div>
        </div>
    </section>

    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">04</span>
                <span><strong>Appearance and motion</strong><small>Applies to every design</small></span>
            </div>
        </div>
        <div class="form-card__body">
            <div class="field-grid">
                <label class="field">
                    <span>Logo height (pixels)</span>
                    <input asp-for="Input.LogoHeight" type="number" min="0" max="160" placeholder="46" />
                    <small class="hint">0 keeps the design’s own size. 46 is the default; 80–110 suits a tall crest.</small>
                </label>
                <label class="switch-row full">
                    <input asp-for="Input.ScrollAnimations" type="checkbox" />
                    <span><strong>Fade sections in as the visitor scrolls</strong><small>Turn off for a completely still page. Visitors who ask their device for reduced motion never see the effect either way.</small></span>
                </label>

                <label class="field">
                    <span>Notice bar colour</span>
                    <input asp-for="Input.NoticeBarColor" placeholder="#c0392b" />
                    <small class="hint">Khaali chhodne par brand colour lagta hai. Admissions ki patti ke liye laal aksar behtar dikhti hai.</small>
                </label>

                <label class="field">
                    <span>Notice bar style</span>
                    <select asp-for="Input.NoticeBarStyle">
                        <option value="">Design ka apna</option>
                        <option value="solid">Solid</option>
                        <option value="gradient">Gradient</option>
                        <option value="dark">Dark</option>
                        <option value="outline">Outline</option>
                    </select>
                </label>

                <label class="switch-row full">
                    <input asp-for="Input.TopBarIcons" type="checkbox" />
                    <span><strong>Top bar mein icons dikhaiye</strong><small>Phone aur email ke saath icon, aur Settings mein bhare hue social links bhi upar aa jayenge.</small></span>
                </label>

                <label class="field">
                    <span>Button colour</span>
                    <input asp-for="Input.ButtonColor" placeholder="#c0392b" />
                    <small class="hint">Sirf buttons ka colour. Khaali chhodne par brand colour lagta hai — pehle poori site ka colour badalna padta tha.</small>
                </label>

                <label class="field">
                    <span>Button style</span>
                    <select asp-for="Input.ButtonStyle">
                        <option value="">Design ka apna</option>
                        <option value="solid">Solid</option>
                        <option value="outline">Outline</option>
                        <option value="soft">Soft</option>
                        <option value="gradient">Gradient</option>
                    </select>
                </label>

                <label class="field">
                    <span>Button shape</span>
                    <select asp-for="Input.ButtonShape">
                        <option value="">Design ka apna</option>
                        <option value="rounded">Rounded</option>
                        <option value="pill">Pill</option>
                        <option value="square">Square</option>
                    </select>
                </label>

                <label class="field">
                    <span>Button hover effect</span>
                    <select asp-for="Input.ButtonHover">
                        <option value="">Design ka apna</option>
                        <option value="lift">Lift</option>
                        <option value="fill">Colour fills in</option>
                        <option value="glow">Glow</option>
                        <option value="slide">Light sweep</option>
                    </select>
                </label>

                <label class="field">
                    <span>Card hover effect</span>
                    <select asp-for="Input.CardHover">
                        <option value="">Design ka apna</option>
                        <option value="lift">Lift</option>
                        <option value="zoom">Zoom</option>
                        <option value="glow">Glow</option>
                        <option value="tilt">Tilt</option>
                    </select>
                    <small class="hint">News, events, staff aur gallery ke cards par lagta hai.</small>
                </label>
            </div>
        </div>
    </section>

    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">05</span>
                <span><strong>Opening popup</strong><small>A poster, an enquiry form, or both — shown when the website opens</small></span>
            </div>
        </div>
        <div class="form-card__body">
            <div class="field-grid">
                <label class="switch-row full">
                    <input asp-for="Input.PopupEnabled" type="checkbox" />
                    <span><strong>Show the popup</strong><small>Nothing appears until there is a poster or the form is switched on.</small></span>
                </label>

                <label class="field full">
                    <span>Poster images</span>
                    <span class="upload-row">
                        <input asp-for="Input.PopupImageUrl" id="settings-popup-image" data-picker-append placeholder="/uploads/… or https://…" />
                        <button type="button" class="btn btn-secondary btn-sm" data-media-picker="#settings-popup-image">Browse media</button>
                    </span>
                    <small class="hint">A tall poster works best — roughly 800×1100. Browse jodta jayega; ek se zyada poster <code>|</code> se alag rehte hain.</small>
                </label>

                <label class="field">
                    <span>Poster badalne ka samay (seconds)</span>
                    <input asp-for="Input.PopupSlideSeconds" type="number" min="0" max="60" placeholder="3" />
                    <small class="hint">0 pehla poster hi rehne deta hai. Do-teen poster ke liye 3 theek hai.</small>
                </label>

                <label class="field">
                    <span>Apne aap band (seconds)</span>
                    <input asp-for="Input.PopupAutoCloseSeconds" type="number" min="0" max="120" placeholder="0" />
                    <small class="hint">0 visitor ke band karne ka intezaar karta hai. Form laga ho to ye lagu nahi hota — koi likh raha ho to band karna theek nahi.</small>
                </label>

                <label class="field"><span>Heading</span><input asp-for="Input.PopupHeading" placeholder="Admissions open 2027–28" /></label>
                <label class="field"><span>Poster links to</span><input asp-for="Input.PopupLinkUrl" placeholder="/admissions" /></label>

                <label class="switch-row full">
                    <input asp-for="Input.PopupShowEnquiryForm" type="checkbox" />
                    <span><strong>Add an enquiry form beside the poster</strong><small>Enquiries arrive in the Contact inbox, same as the contact page.</small></span>
                </label>

                <label class="field full"><span>Form heading</span><input asp-for="Input.PopupFormHeading" placeholder="Request a callback" /></label>

                <label class="switch-row full">
                    <input asp-for="Input.PopupOncePerVisit" type="checkbox" />
                    <span><strong>Show once per visit</strong><small>Off means it opens on every page, which visitors find tiresome quickly.</small></span>
                </label>
            </div>
        </div>
    </section>

    <div class="form-actions form-actions--sticky">
        <button class="btn" type="submit">Save site settings</button>
        <span class="hint">Changes appear on the public website immediately.</span>
    </div>
</form>
