@page
@model Cms.Admin.Areas.CMS.Pages.Departments.IndexModel
@{
    ViewData["Title"] = "Departments";
}

<div class="page-header">
    <div>
        <div class="eyebrow">Academics</div>
        <h1>Departments</h1>
        <p>Publish the academic departments and the programmes each one offers.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice">@Model.StatusMessage</div>
}

<div class="content-manager-layout">
    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">01</span>
                <span><strong>Departments</strong><small>@Model.Departments.Count published in this order</small></span>
            </div>
        </div>
        <div class="content-list">
            @if (Model.Departments.Count == 0)
            {
                <div class="empty-state">
                    <strong>No departments yet</strong>
                    <span>Add Science, Commerce, Humanities or whichever streams this website offers.</span>
                </div>
            }
            @foreach (var department in Model.Departments)
            {
                <article>
                    <span class="content-list__text">
                        <strong>@department.Name</strong>
                        <small>
                            @(string.IsNullOrWhiteSpace(department.HeadOfDepartment) ? "No head assigned" : department.HeadOfDepartment)
                            @if (department.Programmes.Count > 0)
                            {
                                <text> · @department.Programmes.Count programme(s)</text>
                            }
                            · @(department.IsPublished ? "Published" : "Hidden")
                        </small>
                    </span>
                    <span class="content-list__actions">
                        <a class="btn btn-secondary btn-sm" asp-route-edit="@department.Id">Edit</a>
                        @if (Model.CanDelete)
                        {
                            <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Remove @department.Name?');">
                                <input type="hidden" name="id" value="@department.Id" />
                                <button class="btn btn-secondary btn-sm" type="submit">Delete</button>
                            </form>
                        }
                    </span>
                </article>
            }
        </div>
    </section>

    <section class="form-card">
        <div class="form-card__header">
            <div>
                <span class="step-number">02</span>
                <span><strong>@(Model.EditId.HasValue ? "Edit department" : "Add a department")</strong><small>Appears on the public departments page</small></span>
            </div>
        </div>
        <div class="form-card__body">
            <form method="post" asp-page-handler="Save" class="field-grid">
                <input type="hidden" asp-for="EditId" />
                <input type="hidden" asp-for="Input.Key" />
                <div asp-validation-summary="All" class="validation-summary full"></div>

                <label class="field"><span>Department name</span><input asp-for="Input.Name" placeholder="Science" required /></label>
                <label class="field"><span>Head of department</span><input asp-for="Input.HeadOfDepartment" placeholder="Vikram Mehta" /></label>

                <label class="field"><span>Email</span><input asp-for="Input.Email" type="email" /></label>
                <label class="field"><span>Phone</span><input asp-for="Input.Phone" /></label>

                <label class="field full"><span>Summary</span><textarea asp-for="Input.Summary" rows="2" placeholder="One or two lines shown in the listing."></textarea></label>

                <label class="field full">
                    <span>Programmes offered</span>
                    <textarea asp-for="Input.Programmes" rows="5" placeholder="Physics&#10;Chemistry&#10;Biology"></textarea>
                    <small class="field-help">One per line.</small>
                </label>

                <label class="field full"><span>Overview</span><textarea asp-for="Input.Overview" rows="6"></textarea></label>

                <label class="field full">
                    <span>Image</span>
                    <span class="upload-row">
                        <input asp-for="Input.ImageUrl" id="department-image-url" placeholder="/uploads/… or https://…" />
                        <button type="button" class="btn btn-secondary btn-sm" data-media-picker="#department-image-url">Browse media</button>
                    </span>
                </label>

                <label class="field"><span>Display order</span><input asp-for="Input.DisplayOrder" type="number" min="0" /></label>

                <label class="switch-row full">
                    <input asp-for="Input.IsPublished" />
                    <span><strong>Published</strong><small>Uncheck to keep this department off the website.</small></span>
                </label>

                <div class="full form-actions">
                    <button class="btn" type="submit">@(Model.EditId.HasValue ? "Save changes" : "Add department")</button>
                    @if (Model.EditId.HasValue)
                    {
                        <a class="btn btn-secondary" asp-page="Index">Cancel</a>
                    }
                </div>
            </form>
        </div>
    </section>
</div>
