@page
@model Cms.Admin.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Set a new password";
    Layout = "_Layout";
}
<div class="auth-screen">
    <section class="auth-panel">
        <div class="auth-card">
            <div class="auth-brand">
                <span class="brand__symbol">
                    <svg viewBox="0 0 28 28" aria-hidden="true"><path d="M4 9.2 14 4l10 5.2-10 5.2L4 9.2Z"/><path d="M7 12.2v6.1c3.8 3.1 10.2 3.1 14 0v-6.1"/></svg>
                </span>
                <span><strong>EduSphere</strong><small>Experience CMS</small></span>
            </div>

            @if (Model.Completed)
            {
                <h1>Password updated</h1>
                <p>Your new password is active. You can sign in to the CMS now.</p>
                <a class="btn" asp-page="/Account/Login">Go to sign in</a>
            }
            else
            {
                <h1>Set a new password</h1>
                <p>Choose a password for <strong>@Model.Input.Email</strong>.</p>

                <form method="post">
                    <div asp-validation-summary="All" class="error"></div>
                    <input asp-for="Input.Email" type="hidden" />
                    <input asp-for="Input.Token" type="hidden" />
                    <label class="field">
                        <span>New password</span>
                        <span class="input-with-icon">
                            <svg viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                            <input asp-for="Input.NewPassword" type="password"
                                   autocomplete="new-password" required />
                        </span>
                        <small>
                            At least 8 characters with an uppercase letter, a lowercase letter,
                            a digit and a special character.
                        </small>
                    </label>
                    <label class="field">
                        <span>Confirm new password</span>
                        <span class="input-with-icon">
                            <svg viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                            <input asp-for="Input.ConfirmPassword" type="password"
                                   autocomplete="new-password" required />
                        </span>
                    </label>
                    <button type="submit" class="btn">
                        Save password
                        <svg viewBox="0 0 24 24"><path d="M5 12h14M14 7l5 5-5 5"/></svg>
                    </button>
                </form>
            }
        </div>
    </section>

    <aside class="auth-visual">
        <div class="auth-visual__content">
            <span class="auth-visual__tag">
                <svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg>
                Secure by design
            </span>
            <h2>One link, one use, one workspace.</h2>
            <p>Reset links expire and can only be redeemed once, so accounts stay yours alone.</p>
        </div>
    </aside>
</div>
