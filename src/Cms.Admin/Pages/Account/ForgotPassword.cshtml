@page
@model Cms.Admin.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_Layout";
}
<div class="auth-screen">
    <section class="auth-panel">
        <div class="auth-card">
            <div class="auth-brand">
                <span class="brand__symbol">
                    <svg viewBox="0 0 28 28" aria-hidden="true"><path d="M4 9.2 14 4l10 5.2-10 5.2L4 9.2Z"/><path d="M7 12.2v6.1c3.8 3.1 10.2 3.1 14 0v-6.1"/></svg>
                </span>
                <span><strong>EduSphere</strong><small>Experience CMS</small></span>
            </div>

            @if (Model.Submitted)
            {
                <h1>Check your inbox</h1>
                <p>
                    If that address belongs to a CMS account, a password reset link is on its way.
                    The link can be used once and expires.
                </p>
                <a class="btn" asp-page="/Account/Login">Back to sign in</a>
            }
            else
            {
                <h1>Reset your password</h1>
                <p>Enter your work email and we will send you a link to choose a new password.</p>

                <form method="post">
                    <div asp-validation-summary="All" class="error"></div>
                    <label class="field">
                        <span>Work email</span>
                        <span class="input-with-icon">
                            <svg viewBox="0 0 24 24"><path d="M3 5h18v14H3zM3 6l9 7 9-7"/></svg>
                            <input asp-for="Input.Email" type="email" autocomplete="email"
                                   placeholder="name@institution.edu" required />
                        </span>
                    </label>
                    <button type="submit" class="btn">
                        Send reset link
                        <svg viewBox="0 0 24 24"><path d="M5 12h14M14 7l5 5-5 5"/></svg>
                    </button>
                </form>

                <div class="auth-meta">
                    <a asp-page="/Account/Login">Back to sign in</a>
                    <span>Secure workspace</span>
                </div>
            }
        </div>
    </section>

    <aside class="auth-visual">
        <div class="auth-visual__content">
            <span class="auth-visual__tag">
                <svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg>
                Account recovery
            </span>
            <h2>Back to managing your campus story in a moment.</h2>
            <p>Reset links are single-use and time limited, so your workspace stays protected.</p>
        </div>
    </aside>
</div>
