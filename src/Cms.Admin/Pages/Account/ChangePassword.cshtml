@page
@model Cms.Admin.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}

<div class="page-header">
    <div>
        <div class="eyebrow">Your account</div>
        <h1>Change password</h1>
        <p>Update the password you use to sign in to the CMS.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="notice">@Model.StatusMessage</div>
}

<section class="form-card">
    <div class="form-card__body">
        <form method="post" class="field-grid">
            <div asp-validation-summary="All" class="validation-summary full"></div>
            <label class="field full">
                <span>Current password</span>
                <input asp-for="Input.CurrentPassword" type="password"
                       autocomplete="current-password" required />
            </label>
            <label class="field">
                <span>New password</span>
                <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" required />
                <small>
                    At least 8 characters with an uppercase letter, a lowercase letter,
                    a digit and a special character.
                </small>
            </label>
            <label class="field">
                <span>Confirm new password</span>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
            </label>
            <div class="full form-actions">
                <button class="btn" type="submit">Update password</button>
                <a class="btn btn-secondary" asp-area="" asp-page="/Index">Cancel</a>
            </div>
        </form>
    </div>
</section>
