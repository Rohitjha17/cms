@page
@model Cms.Admin.Pages.Account.LoginModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}
<div class="auth-screen">
    <section class="auth-panel">
        <div class="auth-card">
            <div class="auth-brand">
                <span class="brand__symbol">
                    <svg viewBox="0 0 28 28" aria-hidden="true"><path d="M4 9.2 14 4l10 5.2-10 5.2L4 9.2Z"/><path d="M7 12.2v6.1c3.8 3.1 10.2 3.1 14 0v-6.1"/></svg>
                </span>
                <span><strong>EduSphere</strong><small>Experience CMS</small></span>
            </div>

            <h1>Welcome back</h1>
            <p>Sign in to shape your institution’s digital experience.</p>

            <form method="post">
                <div asp-validation-summary="All" class="error"></div>
                <label class="field">
                    <span>Work email</span>
                    <span class="input-with-icon">
                        <svg viewBox="0 0 24 24"><path d="M3 5h18v14H3zM3 6l9 7 9-7"/></svg>
                        <input asp-for="Input.Email" type="email" autocomplete="email" placeholder="name@institution.edu" required />
                    </span>
                </label>
                <label class="field">
                    <span>Password</span>
                    <span class="input-with-icon">
                        <svg viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                        <input asp-for="Input.Password" type="password" autocomplete="current-password" placeholder="Enter your password" required />
                    </span>
                </label>
                <div class="auth-meta">
                    <label><input type="checkbox" checked /> Keep me signed in</label>
                    <a asp-page="/Account/ForgotPassword">Forgot password?</a>
                </div>
                <button type="submit" class="btn">
                    Sign in to CMS
                    <svg viewBox="0 0 24 24"><path d="M5 12h14M14 7l5 5-5 5"/></svg>
                </button>
            </form>

            @if (Environment.IsDevelopment())
            {
                <div class="demo-credentials">
                    Development access: <strong>admin@demo.local</strong> · <strong>Admin@12345</strong>
                </div>
            }
        </div>
    </section>

    <aside class="auth-visual">
        <div class="auth-visual__content">
            <span class="auth-visual__tag">
                <svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg>
                Built for modern institutions
            </span>
            <h2>Every story. Every campus. One beautiful experience.</h2>
            <p>Manage school and college websites with content that feels consistent, intentional and distinctly yours.</p>
            <div class="auth-proof">
                <span><strong>21</strong><small>Dynamic sections</small></span>
                <span><strong>100%</strong><small>Tenant isolated</small></span>
                <span><strong>Live</strong><small>Instant publishing</small></span>
            </div>
        </div>
    </aside>
</div>
