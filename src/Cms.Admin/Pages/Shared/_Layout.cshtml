@inject Cms.Application.Interfaces.ITenantContext TenantContext
@inject Cms.Admin.Services.IPublicSiteLink PublicSite
@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var isHomePageCms = string.Equals(currentArea, "CMS", StringComparison.OrdinalIgnoreCase)
        && currentPage?.StartsWith("/HomePage/", StringComparison.OrdinalIgnoreCase) == true;
    var isMediaCms = string.Equals(currentArea, "CMS", StringComparison.OrdinalIgnoreCase)
        && currentPage?.StartsWith("/Media/", StringComparison.OrdinalIgnoreCase) == true;
    var isPagesCms = currentPage?.StartsWith("/Pages/", StringComparison.OrdinalIgnoreCase) == true;
    var isNavigationCms = currentPage?.StartsWith("/Navigation/", StringComparison.OrdinalIgnoreCase) == true;
    var isDepartmentsCms = currentPage?.StartsWith("/Departments/", StringComparison.OrdinalIgnoreCase) == true;
    var isPeopleCms = currentPage?.StartsWith("/People/", StringComparison.OrdinalIgnoreCase) == true;
    var isNewsCms = currentPage?.StartsWith("/News/", StringComparison.OrdinalIgnoreCase) == true;
    var isEventsCms = currentPage?.StartsWith("/Events/", StringComparison.OrdinalIgnoreCase) == true;
    var isSettingsCms = currentPage?.StartsWith("/Settings/", StringComparison.OrdinalIgnoreCase) == true;
    var isSeoCms = currentPage?.StartsWith("/Seo/", StringComparison.OrdinalIgnoreCase) == true;
    var isTenantsCms = currentPage?.StartsWith("/Tenants/", StringComparison.OrdinalIgnoreCase) == true;
    var isWebsitesCms = currentPage?.StartsWith("/Websites/", StringComparison.OrdinalIgnoreCase) == true;
    var isDomainsCms = currentPage?.StartsWith("/Domains/", StringComparison.OrdinalIgnoreCase) == true;
    var isTemplatesCms = currentPage?.StartsWith("/Templates/", StringComparison.OrdinalIgnoreCase) == true;
    var isBrandingCms = currentPage?.StartsWith("/Branding/", StringComparison.OrdinalIgnoreCase) == true;
    var isContactsCms = currentPage?.StartsWith("/Contacts/", StringComparison.OrdinalIgnoreCase) == true;
    var isPageGalleryCms = currentPage?.StartsWith("/PageGallery/", StringComparison.OrdinalIgnoreCase) == true;
    var isUsersCms = currentPage?.StartsWith("/Users/", StringComparison.OrdinalIgnoreCase) == true;
    var isOverview = string.Equals(currentPage, "/Index", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101b35" />
    <title>@ViewData["Title"] · EduSphere CMS</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "cms-body" : "auth-body")">
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="cms-shell">
        <aside class="sidebar" id="cms-sidebar">
            <div class="brand">
                <span class="brand__symbol">
                    <svg viewBox="0 0 28 28" aria-hidden="true"><path d="M4 9.2 14 4l10 5.2-10 5.2L4 9.2Z"/><path d="M7 12.2v6.1c3.8 3.1 10.2 3.1 14 0v-6.1"/></svg>
                </span>
                <span><strong>EduSphere</strong><small>Experience CMS</small></span>
            </div>

            <div class="sidebar__tenant">
                <span class="tenant-avatar">@((TenantContext.TenantName ?? "C")[0])</span>
                <span><small>Workspace</small><strong>@(TenantContext.TenantName ?? "CMS Workspace")</strong></span>
            </div>

            <nav class="sidebar__nav" aria-label="CMS navigation">
                <div class="nav-label">School website</div>
                <a class="nav-item @(isOverview ? "is-active" : null)" asp-area="" asp-page="/Index">
                    <svg viewBox="0 0 24 24"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"/></svg>
                    <span>Workspace</span>
                </a>
                <a class="nav-item @(isBrandingCms ? "is-active" : null)" asp-area="CMS" asp-page="/Branding/Index">
                    <svg viewBox="0 0 24 24"><path d="M12 3 4 7v5c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V7l-8-4Z"/></svg>
                    <span>Branding</span>
                </a>
                <a class="nav-item @(isHomePageCms ? "is-active" : null)" asp-area="CMS" asp-page="/HomePage/Index">
                    <svg viewBox="0 0 24 24"><path d="m3 11 9-8 9 8"/><path d="M5 10v11h14V10M9 21v-7h6v7"/></svg>
                    <span>Home page</span><span class="nav-count">@Cms.Domain.Constants.HomePageSectionKeys.All.Count</span>
                </a>
                <a class="nav-item @(isPagesCms ? "is-active" : null)" asp-area="CMS" asp-page="/Pages/Index">
                    <svg viewBox="0 0 24 24"><path d="M5 3h11l3 3v15H5zM14 3v5h5M8 12h8M8 16h6"/></svg>
                    <span>Pages</span>
                </a>
                <a class="nav-item @(isContactsCms ? "is-active" : null)" asp-area="CMS" asp-page="/Contacts/Index">
                    <svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM4 9l8 5 8-5"/></svg>
                    <span>Contact inbox</span>
                </a>
                <a class="nav-item @(isNavigationCms ? "is-active" : null)" asp-area="CMS" asp-page="/Navigation/Index">
                    <svg viewBox="0 0 24 24"><path d="M4 5h16M4 12h16M4 19h16"/></svg>
                    <span>Navigation</span>
                </a>

                @if (User.IsInRole(Cms.Domain.Constants.AppRoles.SuperAdmin) || User.IsInRole(Cms.Domain.Constants.AppRoles.TenantAdmin))
                {
                    <div class="nav-label">Platform</div>
                    @if (User.IsInRole(Cms.Domain.Constants.AppRoles.SuperAdmin))
                    {
                        <a class="nav-item @(isTenantsCms ? "is-active" : null)" asp-area="CMS" asp-page="/Tenants/Index">
                            <svg viewBox="0 0 24 24"><path d="M3 21V7l9-4 9 4v14M8 10h2M14 10h2M8 14h2M14 14h2M10 21v-3h4v3"/></svg>
                            <span>Tenants</span>
                        </a>
                    }
                    <a class="nav-item @(isWebsitesCms ? "is-active" : null)" asp-area="CMS" asp-page="/Websites/Index">
                        <svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM4 9h16M9 9v10"/></svg>
                        <span>Websites</span>
                    </a>
                    <a class="nav-item @(isTemplatesCms ? "is-active" : null)" asp-area="CMS" asp-page="/Templates/Index">
                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
                        <span>Website templates</span>
                    </a>
                    <a class="nav-item @(isDomainsCms ? "is-active" : null)" asp-area="CMS" asp-page="/Domains/Index">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.8 3.8 9S14.5 18.3 12 21c-2.5-2.7-3.8-5.8-3.8-9S9.5 5.7 12 3Z"/></svg>
                        <span>Domains</span>
                    </a>
                    <a class="nav-item @(isPageGalleryCms ? "is-active" : null)" asp-area="CMS" asp-page="/PageGallery/Index">
                        <svg viewBox="0 0 24 24"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"/></svg>
                        <span>Page gallery</span>
                    </a>
                    <a class="nav-item @(isUsersCms ? "is-active" : null)" asp-area="CMS" asp-page="/Users/Index">
                        <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.5-4.2 2.9-6 6.5-6s6 1.8 6.5 6M17 5.2c2.4.4 3.6 1.8 3.6 3.7 0 1.9-1.2 3.3-3.6 3.7"/></svg>
                        <span>User accounts</span>
                    </a>
                }

                <div class="nav-label">Content</div>
                <a class="nav-item @(isMediaCms ? "is-active" : null)" asp-area="CMS" asp-page="/Media/Index">
                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9" r="1.5"/><path d="m4 17 5-5 4 4 2-2 5 4"/></svg>
                    <span>Media library</span>
                </a>
                <a class="nav-item @(isNewsCms ? "is-active" : null)" asp-area="CMS" asp-page="/News/Index">
                    <svg viewBox="0 0 24 24"><path d="M4 5h13v14H4zM17 9h3v8a2 2 0 0 1-3 1.7M7 9h7M7 13h7M7 17h4"/></svg>
                    <span>News &amp; notices</span>
                </a>
                <a class="nav-item @(isEventsCms ? "is-active" : null)" asp-area="CMS" asp-page="/Events/Index">
                    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></svg>
                    <span>Events</span>
                </a>
                <a class="nav-item @(isDepartmentsCms ? "is-active" : null)" asp-area="CMS" asp-page="/Departments/Index">
                    <svg viewBox="0 0 24 24"><path d="M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6"/></svg>
                    <span>Departments</span>
                </a>
                <a class="nav-item @(isPeopleCms ? "is-active" : null)" asp-area="CMS" asp-page="/People/Index">
                    <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="4"/><path d="M2 21c.5-5 3-7 7-7s6.5 2 7 7M16 5c3 .3 4.5 2 4.5 4.5S19 14 16 14"/></svg>
                    <span>Faculty &amp; staff</span>
                </a>

                <div class="nav-label">Configuration</div>
                <a class="nav-item @(isSettingsCms ? "is-active" : null)" asp-area="CMS" asp-page="/Settings/Index">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H3v-4h.1a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1a1.7 1.7 0 0 0 1.9.3A1.7 1.7 0 0 0 10 3V3h4v.1a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z"/></svg>
                    <span>Site settings</span>
                </a>
                <a class="nav-item @(isSeoCms ? "is-active" : null)" asp-area="CMS" asp-page="/Seo/Index">
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4M8 11h6M11 8v6"/></svg>
                    <span>SEO settings</span>
                </a>
            </nav>

            <div class="sidebar__footer">
                <div class="user-chip">
                    <span class="user-avatar">@((User.Identity?.Name ?? "A")[0])</span>
                    <span>
                        <strong>@(User.Identity?.Name?.Split('@')[0] ?? "Administrator")</strong>
                        <small><a asp-area="" asp-page="/Account/ChangePassword">Change password</a></small>
                    </span>
                    <form method="post" asp-area="" asp-page="/Account/Logout">
                        <button type="submit" title="Sign out" aria-label="Sign out">
                            <svg viewBox="0 0 24 24"><path d="M10 17l5-5-5-5M15 12H3M15 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4"/></svg>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <div class="cms-main">
            <header class="topbar">
                <button class="icon-button mobile-menu" type="button" data-sidebar-toggle aria-label="Open navigation">
                    <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                </button>
                @await Component.InvokeAsync("SiteSwitcher")
                <div class="topbar__actions">
                    @if (PublicSite.Url is not null)
                    {
                        <a class="icon-button" href="@PublicSite.Url" target="_blank" rel="noopener" title="Open public website">
                            <svg viewBox="0 0 24 24"><path d="M14 3h7v7M21 3l-9 9"/><path d="M18 13v7a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h7"/></svg>
                        </a>
                    }
                    @await Component.InvokeAsync("Notifications")
                </div>
            </header>
            <main class="content">
                @RenderBody()
            </main>
        </div>
        <div class="sidebar-scrim" data-sidebar-toggle></div>
    </div>
}
else
{
    <main class="auth-layout">
        @RenderBody()
    </main>
}
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
<script src="~/js/homepage.js" asp-append-version="true"></script>
<script src="~/js/cms-media-picker.js" asp-append-version="true"></script>
<script src="~/js/page-editor.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
