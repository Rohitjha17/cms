@page
@model Cms.Admin.Pages.IndexModel
@inject Cms.Admin.Services.IPublicSiteLink PublicSite
@{
    ViewData["Title"] = "School workspace";
}
<div class="page-header">
    <div>
        <div class="eyebrow">@(Model.IsSchoolEditor ? "School self-service" : "Workspace overview")</div>
        <h1>@Model.SchoolName</h1>
        <p>@(string.IsNullOrWhiteSpace(Model.Tagline) ? "Manage branding, pages, media and enquiries for this website." : Model.Tagline)</p>
    </div>
    <div class="page-header__actions">
        @if (PublicSite.Url is not null)
        {
            <a class="btn btn-secondary" href="@PublicSite.Url" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                View live website
            </a>
        }
        @if (Model.CanProvision)
        {
            <a class="btn" asp-area="CMS" asp-page="/Websites/Index">
                Create website
                <svg viewBox="0 0 24 24"><path d="M5 12h14M14 7l5 5-5 5"/></svg>
            </a>
        }
        else
        {
            <a class="btn" asp-area="CMS" asp-page="/Branding/Index">
                Edit branding
                <svg viewBox="0 0 24 24"><path d="M5 12h14M14 7l5 5-5 5"/></svg>
            </a>
        }
    </div>
</div>

@if (Model.LoadFailed)
{
    <div class="notice notice--danger">
        The workspace overview could not be loaded, so the figures below are incomplete.
        Check the application logs and refresh.
    </div>
}
else if (Model.NeedsWebsite)
{
    <div class="notice notice--warning">
        No website has been provisioned for this workspace yet.
        @if (Model.CanProvision)
        {
            <a asp-area="CMS" asp-page="/Websites/Index">Create the first website</a><text> to start publishing.</text>
        }
        else
        {
            <text>Ask your administrator to create one before adding content.</text>
        }
    </div>
}

<div class="metric-grid">
    <article class="metric-card">
        <div class="metric-card__top"><span class="metric-card__icon"><svg viewBox="0 0 24 24"><path d="M5 3h11l3 3v15H5zM14 3v5h5"/></svg></span></div>
        <strong class="metric-card__value">@Model.PublishedPageCount/@Model.PageCount</strong>
        <span class="metric-card__label">Published pages</span>
    </article>
    <article class="metric-card">
        <div class="metric-card__top"><span class="metric-card__icon success"><svg viewBox="0 0 24 24"><path d="m3 11 9-8 9 8"/><path d="M5 10v11h14V10"/></svg></span></div>
        <strong class="metric-card__value">@Model.HomeVariant</strong>
        <span class="metric-card__label">Home design</span>
    </article>
    <article class="metric-card">
        <div class="metric-card__top"><span class="metric-card__icon neutral"><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM4 9l8 5 8-5"/></svg></span></div>
        <strong class="metric-card__value">@Model.UnreadContacts</strong>
        <span class="metric-card__label">Unread enquiries</span>
    </article>
    <article class="metric-card">
        <div class="metric-card__top"><span class="metric-card__icon warning"><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM8 9h8M8 13h8"/></svg></span></div>
        <strong class="metric-card__value">@Model.HomeSectionCount</strong>
        <span class="metric-card__label">Home sections</span>
    </article>
</div>

<section class="panel">
    <header class="panel__header">
        <div><strong>School website workspace</strong><small>@Model.TenantName · focused tools for day-to-day updates</small></div>
    </header>
    <div class="panel__body school-quick-grid">
        <a class="school-quick-card" asp-area="CMS" asp-page="/Branding/Index">
            <strong>Branding</strong>
            <small>Logo, colors, header, footer, contact details</small>
        </a>
        <a class="school-quick-card" asp-area="CMS" asp-page="/HomePage/Index">
            <strong>Home page</strong>
            <small>Hero, stats, news, gallery and CTA sections</small>
        </a>
        <a class="school-quick-card" asp-area="CMS" asp-page="/Pages/Index">
            <strong>Pages</strong>
            <small>About, Admission, Gallery, Disclosure, Contact…</small>
        </a>
        <a class="school-quick-card" asp-area="CMS" asp-page="/Media/Index">
            <strong>Media library</strong>
            <small>Upload photos and disclosure PDFs</small>
        </a>
        <a class="school-quick-card" asp-area="CMS" asp-page="/Navigation/Index">
            <strong>Navigation</strong>
            <small>Menus sync from pages; refine labels anytime</small>
        </a>
        <a class="school-quick-card" asp-area="CMS" asp-page="/Contacts/Index">
            <strong>Contact inbox</strong>
            <small>@Model.UnreadContacts new enquiry(ies)</small>
        </a>
        <a class="school-quick-card" asp-area="CMS" asp-page="/Seo/Index">
            <strong>SEO</strong>
            <small>Titles, descriptions and social preview</small>
        </a>
        @if (Model.CanProvision)
        {
            <a class="school-quick-card" asp-area="CMS" asp-page="/PageGallery/Index">
                <strong>Page gallery</strong>
                <small>Assign new page types to this website</small>
            </a>
        }
    </div>
</section>
