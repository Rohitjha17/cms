@inject Cms.Application.Interfaces.IWebsiteService WebsiteService
@inject Cms.Application.Interfaces.ISchoolContentService SchoolContent
@{
    PublicWebsiteDto? shell = ViewData["Website"] as PublicWebsiteDto;
    if (shell is null)
    {
        try { shell = await WebsiteService.GetPublicWebsiteAsync(Context.RequestAborted); }
        catch { shell = new PublicWebsiteDto(); }
    }
    var brand = shell.Branding;
    var primary = string.IsNullOrWhiteSpace(brand.PrimaryColor) ? "#0f2d5c" : brand.PrimaryColor;
    var secondary = string.IsNullOrWhiteSpace(brand.SecondaryColor) ? "#c9a227" : brand.SecondaryColor;
    var title = ViewData["Title"] as string ?? brand.Name;
    // PathBase already carries any "/{siteKey}" prefix, so compare against the full request path.
    // "/school" + "/" would otherwise produce a trailing slash that matches no menu URL.
    var path = ((Context.Request.PathBase.Value ?? string.Empty) + (Context.Request.Path.Value ?? "/"))
        .TrimEnd('/');
    if (path.Length == 0) { path = "/"; }
    var homeUrl = shell.BasePath.Length == 0 ? "/" : shell.BasePath;
    var quickLinks = shell.Navigation.Where(x => x.Url != homeUrl).Take(4).ToList();

    Cms.Application.DTOs.SchoolContent.SiteSettingsDto settings;
    try { settings = await SchoolContent.GetSettingsAsync(Context.RequestAborted); }
    catch { settings = new Cms.Application.DTOs.SchoolContent.SiteSettingsDto(); }

    // Only names this application recognises become classes or colours; anything else is
    // nothing at all rather than a value passed into the page's own markup on trust.
    var skin = string.Join(' ', new[]
    {
        Cms.Web.Helpers.AppearanceChoice.ButtonStyle(settings.ButtonStyle),
        Cms.Web.Helpers.AppearanceChoice.ButtonShape(settings.ButtonShape),
        Cms.Web.Helpers.AppearanceChoice.ButtonHover(settings.ButtonHover),
        Cms.Web.Helpers.AppearanceChoice.CardHover(settings.CardHover),
        Cms.Web.Helpers.AppearanceChoice.ImageHover(settings.ImageHover),
        Cms.Web.Helpers.AppearanceChoice.LinkHover(settings.LinkHover)
    }.Where(x => x is not null));
    var noticeColor = Cms.Web.Helpers.AppearanceChoice.Color(settings.NoticeBarColor);
    var noticeStyle = Cms.Web.Helpers.AppearanceChoice.NoticeStyle(settings.NoticeBarStyle);
    var buttonColor = Cms.Web.Helpers.AppearanceChoice.Color(settings.ButtonColor);
    var hoverColor = Cms.Web.Helpers.AppearanceChoice.Color(settings.HoverColor);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(shell.Seo.MetaTitle is { Length: > 0 } ? $"{title} · {shell.Seo.MetaTitle}" : title)</title>
    @if (!string.IsNullOrWhiteSpace(shell.Seo.MetaDescription))
    {
        <meta name="description" content="@shell.Seo.MetaDescription" />
    }
    @if (!string.IsNullOrWhiteSpace(shell.Seo.MetaKeywords))
    {
        <meta name="keywords" content="@shell.Seo.MetaKeywords" />
    }
    <meta property="og:title" content="@title" />
    @if (!string.IsNullOrWhiteSpace(shell.Seo.MetaDescription))
    {
        <meta property="og:description" content="@shell.Seo.MetaDescription" />
    }
    @if (!string.IsNullOrWhiteSpace(shell.Seo.OgImageUrl))
    {
        <meta property="og:image" content="@shell.Seo.OgImageUrl" />
    }
    @if (!shell.Seo.AllowIndexing)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    @if (!string.IsNullOrWhiteSpace(shell.Seo.CanonicalUrl))
    {
        <link rel="canonical" href="@shell.Seo.CanonicalUrl" />
    }
    @if (!string.IsNullOrWhiteSpace(brand.FaviconUrl))
    {
        <link rel="icon" href="@brand.FaviconUrl" />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    @{ var typeface = Cms.Web.Helpers.DesignIdentity.Fonts(brand.HomeVariant); }
    <link href="https://fonts.googleapis.com/css2?@(typeface.Query)&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>:root{--brand:@primary;--accent:@secondary;@(settings.LogoHeight > 0 ? $"--logo-size:{Math.Clamp(settings.LogoHeight, 28, 160)}px;" : "")@(buttonColor is null ? "" : $"--btn-color:{buttonColor};")@(hoverColor is null ? "" : $"--hover-color:{hoverColor};")@* Raw because a font stack contains apostrophes — 'Segoe UI' — and Razor encodes them to
       &#x27;, which makes the whole declaration invalid and drops every design back to Times.
       These strings come from DesignIdentity, not from anything a school can type. *@
--font-display:@Html.Raw(typeface.Display);--font-body:@Html.Raw(typeface.Body);}</style>
</head>
<body class="variant-@brand.HomeVariant.ToString().ToLowerInvariant() @skin @(settings.HeroPlainImages ? "hero-plain" : null)" data-scroll-animations="@(settings.ScrollAnimations ? "on" : "off")">
    @if (!string.IsNullOrWhiteSpace(settings.NoticeTicker))
    {
        if (settings.NoticeTickerScrolls)
        {
            // The text is repeated so the loop has no gap at the seam. aria-hidden on the copy
            // keeps a screen reader from announcing the notice twice.
            // A school runs more than one notice at a time — admissions and a results day, say —
            // so the field takes several separated by a vertical bar.
            var notices = settings.NoticeTicker
                .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            <div class="notice-bar notice-bar--scrolling @noticeStyle" style="@(noticeColor is null ? null : $"background:{noticeColor}")">
                @if (!string.IsNullOrWhiteSpace(settings.NoticeLabel)) { <span class="notice-bar__tag">@settings.NoticeLabel</span> }
                <div class="notice-marquee" data-notice-marquee
                     data-notice-repeat="@Math.Clamp(settings.NoticeTickerRepeat, 0, 3)"
                     style="@(settings.NoticeTickerSeconds > 0 ? $"--notice-speed:{Math.Clamp(settings.NoticeTickerSeconds, 5, 120)}s" : null)">
                    <div class="notice-marquee__set">
                        @foreach (var notice in notices) { <span>@notice</span> }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="notice-bar @noticeStyle" style="@(noticeColor is null ? null : $"background:{noticeColor}")"><div class="shell">@if (!string.IsNullOrWhiteSpace(settings.NoticeLabel)) { <span class="notice-bar__tag">@settings.NoticeLabel</span> }<span>@settings.NoticeTicker.Replace(" | ", " · ").Replace("|", " · ")</span></div></div>
        }
    }
    @{
        var utility = settings.TopBarLinkList;
        // The tagline was printed here and again under the school's name, so a site with no
        // portals and no phone number showed an empty grey band with one line repeated in it.
        // The strip is for links; with no links there is no strip.
        // The header carries the phone and email as "Call us" and "Mail us" when that is turned
        // on, and printing them again one line above is the same two lines of text twice on the
        // same screen. The strip keeps the links and the social icons; the header keeps the
        // contact details. Only one of them says a thing.
        var stripContact = !settings.HeaderContact;
        // The social accounts are on the contact page and in the footer; a third copy of the
        // same five icons at the top of every page is the same row said three times.
        var hasStrip = utility.Count > 0
            || (stripContact && (!string.IsNullOrWhiteSpace(brand.Phone)
                || !string.IsNullOrWhiteSpace(brand.Email)));
    }
    @if (hasStrip)
    {
    <div class="top-meta @(settings.TopBarIcons ? "top-meta--icons" : null)">
        <div class="shell">
            @if (utility.Count > 0)
            {
                @* The strip above the header is where a school parks the pages that are not part
                   of the story it tells — the parent portal, the alumni register, the disclosures
                   the board requires — so the navigation below stays about the school itself. *@
                <nav class="top-meta__utility" aria-label="Quick links">
                    @foreach (var link in utility)
                    {
                        <a href="@link.Url">@link.Label</a>
                    }
                </nav>
            }
            <span class="top-meta__links">
                @if (stripContact && !string.IsNullOrWhiteSpace(brand.Phone))
                {
                    <a href="tel:@brand.Phone">@if (settings.TopBarIcons) { <partial name="_Icon" model="@("phone")" /> }<span>@brand.Phone</span></a>
                }
                @if (stripContact && !string.IsNullOrWhiteSpace(brand.Email))
                {
                    <a href="mailto:@brand.Email">@if (settings.TopBarIcons) { <partial name="_Icon" model="@("mail")" /> }<span>@brand.Email</span></a>
                }

            </span>
        </div>
    </div>
    }
    <header class="site-header">
        <div class="shell">
            <a class="brand" href="@homeUrl">
                @if (!string.IsNullOrWhiteSpace(brand.LogoUrl))
                {
                    <img src="@brand.LogoUrl" alt="@brand.Name" />
                }
                <span>
                    <strong>@brand.Name</strong>
                    @if (!string.IsNullOrWhiteSpace(brand.Tagline))
                    {
                        <small>@brand.Tagline</small>
                    }
                </span>
            </a>
            @if (settings.HeaderContact)
            {
                @* Both reference sites put the phone, the email and one call to action in the
                   header itself rather than in a strip above it, because those are the three
                   things a parent came for. *@
                <div class="header-contact">
                    @if (!string.IsNullOrWhiteSpace(brand.Phone))
                    {
                        <a href="tel:@brand.Phone">
                            <partial name="_Icon" model="@("phone")" />
                            <span><small>Call us</small><strong>@brand.Phone</strong></span>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(brand.Email))
                    {
                        <a href="mailto:@brand.Email">
                            <partial name="_Icon" model="@("mail")" />
                            <span><small>Mail us</small><strong>@brand.Email</strong></span>
                        </a>
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(settings.HeaderCtaText))
            {
                <a class="btn header-cta" href="@(settings.HeaderCtaLink ?? shell.BasePath + "/admission")">@settings.HeaderCtaText</a>
            }
            <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false">Menu</button>
            <nav aria-label="Primary" data-primary-nav>
                @foreach (var item in shell.Navigation)
                {
                    // Home matches only its own URL; every other entry also matches its subtree,
                    // otherwise Home would stay highlighted on every page of the site.
                    var isHome = item.Url == homeUrl || item.Url == "/";
                    var active = string.Equals(item.Url, path, StringComparison.OrdinalIgnoreCase)
                        || (!isHome && path.StartsWith(item.Url + "/", StringComparison.OrdinalIgnoreCase));
                    <a href="@item.Url" target="@(item.Target ?? "_self")" class="@(active ? "is-active" : null)">@item.Label</a>
                }
            </nav>
        </div>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="shell footer-grid">
            <div>
                <strong>@brand.Name</strong>
                <p>@(brand.FooterText ?? $"© {DateTime.UtcNow.Year} {brand.Name}. All rights reserved.")</p>
            </div>
            <div>
                <strong>Visit</strong>
                @if (!string.IsNullOrWhiteSpace(brand.Address)) { <p>@brand.Address</p> }
                @if (!string.IsNullOrWhiteSpace(settings.OfficeHours)) { <p class="muted">@settings.OfficeHours</p> }
            </div>
            <div>
                <strong>Reach us</strong>
                @* Written as links rather than as text: on a phone this is the one place a
                   parent will tap to call, and the footer is where they scroll to find it. *@
                @if (!string.IsNullOrWhiteSpace(brand.Phone)) { <p><a href="tel:@brand.Phone">@brand.Phone</a></p> }
                @if (!string.IsNullOrWhiteSpace(brand.Email)) { <p><a href="mailto:@brand.Email">@brand.Email</a></p> }
                @if (!string.IsNullOrWhiteSpace(settings.WhatsAppNumber))
                {
                    <p><a href="https://wa.me/@settings.WhatsAppNumber.Trim('+', ' ')" target="_blank" rel="noopener">WhatsApp</a></p>
                }
                <partial name="_SocialLinks" model="settings" />
                @if (quickLinks.Count > 0)
                {
                    <p>
                        @for (var i = 0; i < quickLinks.Count; i++)
                        {
                            if (i > 0) { <text> · </text> }
                            <a href="@quickLinks[i].Url">@quickLinks[i].Label</a>
                        }
                    </p>
                }
            </div>
        </div>
    </footer>
    @if (settings.HasPopup)
    {
        var popupFormHeading = string.IsNullOrWhiteSpace(settings.PopupFormHeading)
            ? "Request a callback"
            : settings.PopupFormHeading;
        <div class="site-popup" data-site-popup
             data-popup-key="@(settings.PopupOncePerVisit ? "visit" : "always")"
             data-popup-slide="@(settings.PopupSlideSeconds > 0 ? Math.Clamp(settings.PopupSlideSeconds, 1, 60) : 0)"
             data-popup-autoclose="@(settings.PopupAutoCloseSeconds > 0 ? Math.Clamp(settings.PopupAutoCloseSeconds, 2, 120) : 0)"
             hidden>
            <div class="site-popup__backdrop" data-popup-close></div>
            <div class="site-popup__panel" role="dialog" aria-modal="true"
                 aria-label="@(settings.PopupHeading ?? brand.Name)">
                <button class="site-popup__close" type="button" data-popup-close aria-label="Close">&times;</button>
                @if (settings.PopupImages.Count > 0)
                {
                    var posterAlt = settings.PopupHeading ?? brand.Name;
                    <div class="site-popup__poster">
                        @for (var i = 0; i < settings.PopupImages.Count; i++)
                        {
                            <figure class="site-popup__slide @(i == 0 ? "is-active" : null)">
                                @if (!string.IsNullOrWhiteSpace(settings.PopupLinkUrl))
                                {
                                    <a href="@settings.PopupLinkUrl"><img src="@settings.PopupImages[i]" alt="@posterAlt" /></a>
                                }
                                else
                                {
                                    <img src="@settings.PopupImages[i]" alt="@posterAlt" />
                                }
                            </figure>
                        }
                        @if (settings.PopupImages.Count > 1)
                        {
                            <button class="site-popup__arrow site-popup__arrow--prev" type="button"
                                    data-popup-prev aria-label="Previous poster">&#8249;</button>
                            <button class="site-popup__arrow site-popup__arrow--next" type="button"
                                    data-popup-next aria-label="Next poster">&#8250;</button>
                            <div class="site-popup__dots">
                                @for (var i = 0; i < settings.PopupImages.Count; i++)
                                {
                                    <button type="button" class="@(i == 0 ? "is-active" : null)"
                                            data-popup-dot="@i" aria-label="Poster @(i + 1)"></button>
                                }
                            </div>
                        }
                    </div>
                }
                @if (settings.PopupShowEnquiryForm)
                {
                    <div class="site-popup__form">
                        @if (!string.IsNullOrWhiteSpace(settings.PopupHeading))
                        {
                            <h2>@settings.PopupHeading</h2>
                        }
                        <h3>@popupFormHeading</h3>
                        @if (TempData["EnquiryStatus"] is string enquiryStatus && !string.IsNullOrWhiteSpace(enquiryStatus))
                        {
                            <p class="site-popup__status">@enquiryStatus</p>
                        }
                        <form method="post" action="@(shell.BasePath)/enquiry">
                            @Html.AntiForgeryToken()
                            <label><span>Name</span><input name="Input.Name" required autocomplete="name" /></label>
                            <label><span>Email</span><input name="Input.Email" type="email" required autocomplete="email" /></label>
                            <label><span>Phone</span><input name="Input.Phone" autocomplete="tel" /></label>
                            @if (settings.EnquiryTypeList.Count > 0)
                            {
                                <label>
                                    <span>Enquiry type</span>
                                    <select name="Input.Subject" required>
                                        <option value="">Please choose</option>
                                        @foreach (var kind in settings.EnquiryTypeList)
                                        {
                                            <option value="@kind">@kind</option>
                                        }
                                    </select>
                                </label>
                            }
                            <label><span>Message</span><textarea name="Input.Message" rows="3" required></textarea></label>
                            <button type="submit">Send enquiry</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
