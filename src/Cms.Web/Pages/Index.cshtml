@page
@model Cms.Web.Pages.IndexModel
@using Cms.Web.Helpers
@using System.Text.Json
@{
    var brand = Model.Website.Branding;

    // Each section can say how it should arrive on screen. Handing the choices to the script as
    // one map keeps every design's markup untouched — the alternative is threading an attribute
    // through six partials, which is six chances to miss one.
    var animations = Model.Website.HomeSections
        .Select(section => new
        {
            section.SectionKey,
            Animation = SectionJson.GetString(SectionJson.Parse(section.JsonData), "animation")
        })
        .Select(x => new
        {
            x.SectionKey,
            Animation = string.IsNullOrWhiteSpace(x.Animation) ? Model.Settings.SectionAnimation : x.Animation
        })
        .Where(x => !string.IsNullOrWhiteSpace(x.Animation))
        .ToDictionary(x => x.SectionKey, x => x.Animation!);

    // A section can also answer the pointer its own way, rather than the whole site sharing one
    // hover. Only names this application recognises survive.
    var hovers = Model.Website.HomeSections
        .Select(section => new
        {
            section.SectionKey,
            Hover = AppearanceChoice.SectionHover(
                SectionJson.GetString(SectionJson.Parse(section.JsonData), "hover"))
        })
        .Where(x => x.Hover is not null)
        .ToDictionary(x => x.SectionKey, x => x.Hover!);
}

@if (animations.Count > 0)
{
    <script>window.cmsSectionAnimations = @Html.Raw(JsonSerializer.Serialize(animations));</script>
}

@if (hovers.Count > 0)
{
    <script>window.cmsSectionHovers = @Html.Raw(JsonSerializer.Serialize(hovers));</script>
}

@{
    // A background belongs to one section, and every design lays its sections out differently,
    // so it is applied by selector rather than by editing six partials. Emitting the rules here
    // rather than setting them from script also means the background is painted on first paint —
    // a photograph that fades in after the text has settled looks like a mistake.
    // A site-wide default keeps a school from having to set twenty-three sections one at a
    // time; a section that chose for itself is never overruled by it.
    var defaultPattern = Model.Settings.SectionPattern;

    // The hero is not one of these. It already has a picture — the banner, or the slideshow —
    // and its own shading under the heading. Giving it a second background image and the white
    // veil that goes under one puts a near-opaque sheet over the whole banner: the school's
    // photograph arrives on the page washed out, which is what this looked like.
    var backdrops = Model.Website.HomeSections
        .Where(section => !string.Equals(section.SectionKey, Cms.Domain.Constants.HomePageSectionKeys.Hero,
            StringComparison.OrdinalIgnoreCase))
        .Select(section => new
        {
            section.SectionKey,
            Image = section.BackgroundImageUrl,
            Pattern = SectionJson.GetString(SectionJson.Parse(section.JsonData), "background")
                ?? defaultPattern,
            Color = AppearanceChoice.Color(
                SectionJson.GetString(SectionJson.Parse(section.JsonData), "backgroundColor"))
        })
        .Where(x => !string.IsNullOrWhiteSpace(x.Image)
            || !string.IsNullOrWhiteSpace(x.Pattern)
            || x.Color is not null)
        .ToList();
}

@if (backdrops.Count > 0)
{
    <style>
        @foreach (var backdrop in backdrops)
        {
            var photo = SectionBackdrop.SafeUrl(backdrop.Image);
            if (backdrop.Color is not null)
            {
                @Html.Raw($"[data-section=\"{backdrop.SectionKey}\"]{{background-color:{backdrop.Color}}}")
            }
            var style = SectionBackdrop.Style(backdrop.Pattern);
            var selector = $"[data-section=\"{backdrop.SectionKey}\"]";
            var motion = style?.Animation is { } animation ? $";animation:{animation}" : string.Empty;

            if (photo.Length > 0)
            {
                @Html.Raw($"{selector}::before{{background-image:url(\"{photo}\");opacity:1}}")
                // A veil under the type, or the words vanish into whatever photograph was picked.
                var veil = "color-mix(in srgb, var(--surface) 86%, transparent)";
                if (style is null)
                {
                    @Html.Raw($"{selector}::after{{background-image:linear-gradient({veil},{veil});background-size:cover;opacity:1}}")
                }
                else
                {
                    @Html.Raw($"{selector}::after{{background-image:linear-gradient({veil},{veil}),{style.Image};background-size:cover,{style.Size};opacity:1{motion}}}")
                }
            }
            else if (style is not null)
            {
                @Html.Raw($"{selector}::after{{background-image:{style.Image};background-size:{style.Size};opacity:.07{motion}}}")
            }
        }
    </style>
}

@if (brand.HomeVariant == HomeVariant.Bulletin)
{
    <partial name="Home/_Bulletin" model="Model.Website" />
}
else if (brand.HomeVariant == HomeVariant.Atrium)
{
    <partial name="Home/_Atrium" model="Model.Website" />
}
else if (brand.HomeVariant == HomeVariant.Modern)
{
    <partial name="Home/_Modern" model="Model.Website" />
}
else if (brand.HomeVariant == HomeVariant.Campus)
{
    <partial name="Home/_Campus" model="Model.Website" />
}
else if (brand.HomeVariant == HomeVariant.Academic)
{
    <partial name="Home/_Academic" model="Model.Website" />
}
else if (brand.HomeVariant == HomeVariant.Prestige)
{
    <partial name="Home/_Prestige" model="Model.Website" />
}
else
{
    <partial name="Home/_Classic" model="Model.Website" />
}
