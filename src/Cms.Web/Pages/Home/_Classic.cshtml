@model PublicWebsiteDto
@using Cms.Web.Helpers
@{
    var brand = Model.Branding;
    var basePath = Model.BasePath;
    var hero = Model.HomeSections.FirstOrDefault(s => s.SectionKey == "hero");
    var stats = Model.HomeSections.FirstOrDefault(s => s.SectionKey == "statistics");
    var why = Model.HomeSections.FirstOrDefault(s => s.SectionKey == "why_choose_us");
    var gallery = Model.HomeSections.FirstOrDefault(s => s.SectionKey == "gallery");
    var news = Model.HomeSections.FirstOrDefault(s => s.SectionKey == "latest_news");
    var cta = Model.HomeSections.FirstOrDefault(s => s.SectionKey == "admission_cta");
    var heroJson = SectionJson.Parse(hero?.JsonData);
    var statsJson = SectionJson.Parse(stats?.JsonData);
    var whyJson = SectionJson.Parse(why?.JsonData);
    var galleryJson = SectionJson.Parse(gallery?.JsonData);
    var newsJson = SectionJson.Parse(news?.JsonData);
    var ctaJson = SectionJson.Parse(cta?.JsonData);
    var banner = brand.HeaderImageUrl ?? "https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&w=1800&q=80";
    var heading = SectionJson.GetString(heroJson, "heading") ?? hero?.Title ?? brand.Name;
    var description = SectionJson.GetString(heroJson, "description") ?? RichText.ToPlainText(hero?.Description) ?? brand.Tagline;
}
<section class="hero hero-classic" style="--hero:url('@banner')">
    <div class="shell hero-copy">
        <p class="eyebrow">@brand.WebsiteType</p>
        <h1>@heading</h1>
        <p>@description</p>
        <div class="cta-row">
            <a class="btn" href="@(hero?.ButtonLink ?? "/admission")">@(SectionJson.GetString(heroJson, "primaryButton") ?? hero?.ButtonText ?? "Apply now")</a>
            <a class="btn btn-ghost" href="@(basePath)/contact">@(SectionJson.GetString(heroJson, "secondaryButton") ?? "Contact")</a>
        </div>
    </div>
</section>

@if (stats is not null)
{
    <section class="shell stats-grid">
        <div class="stat"><strong>@(SectionJson.GetString(statsJson, "students") ?? "1500")+ </strong><span>Students</span></div>
        <div class="stat"><strong>@(SectionJson.GetString(statsJson, "teachers") ?? "80")+ </strong><span>Teachers</span></div>
        <div class="stat"><strong>@(SectionJson.GetString(statsJson, "placements") ?? "500")+ </strong><span>Placements</span></div>
        <div class="stat"><strong>@(SectionJson.GetString(statsJson, "years") ?? "20")+ </strong><span>Years</span></div>
    </section>
}

@if (why is not null)
{
    <section class="shell section">
        <div class="section-head">
            <p class="eyebrow">Why families choose us</p>
            <h2>@why.Title</h2>
            <p>@(SectionJson.GetString(whyJson, "intro") ?? why.SubTitle ?? why.Description)</p>
        </div>
        <div class="card-grid">
            @foreach (var item in SectionJson.GetArray(whyJson, "items"))
            {
                <article>
                    <h3>@(item.TryGetProperty("title", out var t) ? t.GetString() : "")</h3>
                    <p>@(item.TryGetProperty("description", out var d) ? d.GetString() : "")</p>
                </article>
            }
        </div>
    </section>
}

@if (gallery is not null)
{
    <section class="shell section">
        <div class="section-head">
            <p class="eyebrow">Campus life</p>
            <h2>@gallery.Title</h2>
        </div>
        <div class="gallery-grid">
            @foreach (var item in SectionJson.GetArray(galleryJson, "items").Take(6))
            {
                var imageUrl = item.TryGetProperty("imageUrl", out var iu) ? iu.GetString() : "";
                var caption = item.TryGetProperty("title", out var ct) ? ct.GetString() : "";
                if (!string.IsNullOrWhiteSpace(imageUrl))
                {
                    <figure><img src="@imageUrl" alt="@caption" loading="lazy" /><figcaption>@caption</figcaption></figure>
                }
            }
        </div>
        <a class="text-link" href="@(basePath)/gallery">View full gallery</a>
    </section>
}

@if (news is not null)
{
    <section class="shell section muted">
        <h2>@news.Title</h2>
        <div class="card-grid">
            @foreach (var item in SectionJson.GetArray(newsJson, "items").Take(3))
            {
                <article>
                    <h3>@(item.TryGetProperty("title", out var nt) ? nt.GetString() : "")</h3>
                    <p>@(item.TryGetProperty("date", out var nd) ? nd.GetString() : "")</p>
                </article>
            }
        </div>
    </section>
}

@if (cta is not null)
{
    <section class="cta-band">
        <div class="shell">
            <h2>@(SectionJson.GetString(ctaJson, "heading") ?? cta.Title)</h2>
            <p>@(SectionJson.GetString(ctaJson, "supportingText") ?? cta.Description)</p>
            <a class="btn" href="@(cta.ButtonLink ?? "/admission")">@(cta.ButtonText ?? "Start application")</a>
        </div>
    </section>
}
