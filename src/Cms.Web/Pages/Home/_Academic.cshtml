@model PublicWebsiteDto
@using Cms.Web.Helpers
@{
    var brand = Model.Branding;
    var basePath = Model.BasePath;
    var hero = Model.HomeSections.FirstOrDefault(s => s.SectionKey == "hero");
    var departments = Model.HomeSections.FirstOrDefault(s => s.SectionKey == "departments");
    var achievements = Model.HomeSections.FirstOrDefault(s => s.SectionKey == "achievements");
    var stats = Model.HomeSections.FirstOrDefault(s => s.SectionKey == "statistics");
    var heroJson = SectionJson.Parse(hero?.JsonData);
    var departmentsJson = SectionJson.Parse(departments?.JsonData);
    var achievementsJson = SectionJson.Parse(achievements?.JsonData);
    var statsJson = SectionJson.Parse(stats?.JsonData);
    var banner = brand.HeaderImageUrl ?? "https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=1800&q=80";
}
<section data-section="hero" class="hero hero-academic" style="--hero:url('@banner')">
    <div class="shell">
        <p class="eyebrow">Academic excellence</p>
        <h1>@(SectionJson.GetString(heroJson, "heading") ?? hero?.Title ?? brand.Name)</h1>
        <p>@(SectionJson.GetString(heroJson, "description") ?? RichText.ToPlainText(hero?.Description) ?? brand.Tagline)</p>
        <div class="cta-row">
            <a class="btn" href="@(basePath)/admission">Admission guide</a>
            <a class="btn btn-ghost" href="@(basePath)/mandatory-disclosure">Mandatory disclosure</a>
        </div>
    </div>
</section>
@if (stats is not null)
{
    <section data-section="statistics" class="shell stats-grid">
        <div class="stat"><strong>@(SectionJson.GetString(statsJson, "students") ?? "—")</strong><span>Students</span></div>
        <div class="stat"><strong>@(SectionJson.GetString(statsJson, "teachers") ?? "—")</strong><span>Faculty</span></div>
        <div class="stat"><strong>@(SectionJson.GetString(statsJson, "years") ?? "—")</strong><span>Years</span></div>
        <div class="stat"><strong>@(SectionJson.GetString(statsJson, "placements") ?? "—")</strong><span>Outcomes</span></div>
    </section>
}
<section data-section="departments" class="shell academic-columns">
    <article>
        <h2>@(departments?.Title ?? "Departments")</h2>
        @foreach (var item in SectionJson.GetArray(departmentsJson, "items"))
        {
            <p><strong>@(item.TryGetProperty("title", out var t) ? t.GetString() : "")</strong> — @(item.TryGetProperty("description", out var d) ? d.GetString() : "")</p>
        }
        <a class="text-link" href="@(basePath)/about">About the institution</a>
    </article>
    <article>
        <h2>@(achievements?.Title ?? "Recognition")</h2>
        @foreach (var item in SectionJson.GetArray(achievementsJson, "items"))
        {
            <p><strong>@(item.TryGetProperty("title", out var t) ? t.GetString() : "")</strong>
            (@(item.TryGetProperty("year", out var y) ? y.GetString() : ""))<br />
            @(item.TryGetProperty("description", out var d) ? d.GetString() : "")</p>
        }
        <a class="text-link" href="@(basePath)/messages">Leadership messages</a>
    </article>
</section>

@{
    // Anything the console can edit that this design does not lay out itself is still shown,
    // in the console's own order, so no edit is invisible on the website.
    ViewData["renderedSections"] = new[] { "hero", "departments", "achievements", "statistics" };
}
<partial name="Home/_RemainingSections" model="Model" />
