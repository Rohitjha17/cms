@model PublicWebsiteDto
@using Cms.Application.DTOs.SchoolContent
@using Cms.Web.Helpers
@{
    // Every design renders a handful of sections in its own bespoke way and used to ignore the
    // rest, so most of what the console offers to edit never appeared on the website at all —
    // the principal's message, the chairman's message, announcements, and a dozen more. The
    // design still owns its own blocks; everything else is rendered here, in the order the
    // console shows, so nothing an editor fills in is silently invisible.
    var handled = (ViewData["renderedSections"] as string[] ?? []).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var basePath = Model.BasePath;
    var news = ViewData["News"] as IReadOnlyList<NewsArticleDto> ?? [];
    var events = ViewData["Events"] as IReadOnlyList<SchoolEventDto> ?? [];
    var faculty = ViewData["Faculty"] as IReadOnlyList<FacultyMemberDto> ?? [];

    var remaining = Model.HomeSections
        .Where(s => !handled.Contains(s.SectionKey))
        .ToList();
}

@foreach (var block in remaining)
{
    var json = SectionJson.Parse(block.JsonData);
    var items = SectionJson.GetArray(json, "items").ToList();
    var body = RichText.ToPlainText(block.Description);
    var intro = SectionJson.GetString(json, "intro") ?? block.SubTitle;

    // A heading with nothing under it reads as the page having broken, and the client's website
    // carried five of them at once — Notable Alumni, Staff List, Facilities, Downloads and
    // School Timings, each a title over an empty stretch of page. Emptying every section on a
    // demo site turned up six more: Departments, Testimonials, Achievements, Partners, the
    // crest and the founder, each a title over 45 to 115 pixels of nothing.
    //
    // So the rule is general rather than a list of section keys. A section is drawn when it has
    // something to draw: anything written in its settings, a description, a picture, a
    // subtitle — or a list it is fed from, which is where events, news and the staff table get
    // their rows even with settings of their own that are empty.
    //
    // This is the same test the console uses to mark a section "Needs content", so the two
    // agree: a section the console calls empty is a section the website does not draw, and the
    // editor hears about it in the one place a visitor never sees.
    var fedByAList = block.SectionKey switch
    {
        "upcoming_events" => events.Count > 0,
        "latest_news" or "announcements" => news.Count > 0,
        "staff_list" => faculty.Count > 0,
        _ => false
    };
    if (!fedByAList
        && !SectionJson.HoldsSomething(json)
        && string.IsNullOrWhiteSpace(block.Description)
        && string.IsNullOrWhiteSpace(block.ImageUrl)
        && string.IsNullOrWhiteSpace(block.SubTitle))
    {
        continue;
    }

    switch (block.SectionKey)
    {
        case "announcements":
        case "latest_news":
            @if (news.Count > 0 || items.Count > 0)
            {
                <section data-section="@block.SectionKey" class="shell section">
                    <div class="section-head">
                        <p class="eyebrow">Announcements</p>
                        <h2>@(block.Title ?? "News and notices")</h2>
                        @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                    </div>
                    <div class="card-grid">
                        @if (news.Count > 0)
                        {
                            @foreach (var item in news.Take(3))
                            {
                                <article>
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Headline" loading="lazy" />
                                    }
                                    <div class="card-grid__text">
                                        <p class="eyebrow">@item.Category</p>
                                        <h3><a href="@(basePath)/news/@item.Key">@item.Headline</a></h3>
                                        @if (!string.IsNullOrWhiteSpace(item.Summary)) { <p>@item.Summary</p> }
                                    </div>
                                </article>
                            }
                        }
                        else
                        {
                            @foreach (var item in items.Take(3))
                            {
                                <article>
                                    @if (SectionJson.Item(item, "imageUrl") is { Length: > 0 } newsPicture)
                                    {
                                        <img src="@newsPicture" alt="@SectionJson.Item(item, "title")" loading="lazy" />
                                    }
                                    <h3>@SectionJson.Item(item, "title")</h3>
                                    <p>@SectionJson.Item(item, "summary")</p>
                                </article>
                            }
                        }
                    </div>
                    <p class="section-more"><a class="btn btn-ghost" href="@(basePath)/news">All news and notices</a></p>
                </section>
            }
            break;

        case "upcoming_events":
            @if (events.Count > 0 || items.Count > 0)
            {
                <section data-section="@block.SectionKey" class="shell section">
                    <div class="section-head">
                        <p class="eyebrow">What's on</p>
                        <h2>@(block.Title ?? "Upcoming events")</h2>
                        @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                    </div>
                    <div class="card-grid">
                        @if (events.Count > 0)
                        {
                            @foreach (var item in events.Take(3))
                            {
                                <article>
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                                    }
                                    <div class="card-grid__text">
                                        <p class="eyebrow">@(item.StartsOn?.ToString("dd MMM yyyy"))</p>
                                        <h3><a href="@(basePath)/events/@item.Key">@item.Title</a></h3>
                                        @if (!string.IsNullOrWhiteSpace(item.Venue)) { <p class="card-meta">@item.Venue</p> }
                                        @if (!string.IsNullOrWhiteSpace(item.Summary)) { <p>@item.Summary</p> }
                                    </div>
                                </article>
                            }
                        }
                        else
                        {
                            @foreach (var item in items.Take(3))
                            {
                                <article>
                                    @if (SectionJson.Item(item, "imageUrl") is { Length: > 0 } eventPicture)
                                    {
                                        <img src="@eventPicture" alt="@SectionJson.Item(item, "title")" loading="lazy" />
                                    }
                                    <h3>@SectionJson.Item(item, "title")</h3>
                                    <p>@SectionJson.Item(item, "location")</p>
                                </article>
                            }
                        }
                    </div>
                    <p class="section-more"><a class="btn btn-ghost" href="@(basePath)/events">All events</a></p>
                </section>
            }
            break;

        case "principal":
        case "chairman":
        case "director":
        case "manager":
            {
                var person = SectionJson.GetString(json, "personName");
                var role = SectionJson.GetString(json, "designation");
                var quote = SectionJson.GetString(json, "quote");
                // A school that has switched this section on but not yet written the message
                // was getting the empty block anyway — a heading with a blank space under it,
                // and the spacing of a section with something in it. Draw it when there is
                // something to draw.
                var hasMessage = !string.IsNullOrWhiteSpace(block.ImageUrl)
                    || !string.IsNullOrWhiteSpace(quote)
                    || !string.IsNullOrWhiteSpace(block.Description)
                    || !string.IsNullOrWhiteSpace(person);

                // Guarding only the message left the heading and the section's own padding
                // behind: "Director Message" over 150px of nothing, and the same again for the
                // manager. A message nobody has written is not a section of the website yet.
                if (hasMessage)
                {
                <section data-section="@block.SectionKey" class="shell section message-section">
                    <div class="section-head">
                        <p class="eyebrow">@(role ?? block.Title)</p>
                        <h2>@(block.Title ?? role)</h2>
                    </div>
                    <div class="message-block">
                        @if (!string.IsNullOrWhiteSpace(block.ImageUrl))
                        {
                            <img class="message-portrait" src="@block.ImageUrl" alt="@person" loading="lazy" />
                        }
                        <div>
                            @if (!string.IsNullOrWhiteSpace(quote)) { <blockquote>@quote</blockquote> }
                            @if (!string.IsNullOrWhiteSpace(block.Description)) { @Html.Raw(block.Description) }
                            @if (!string.IsNullOrWhiteSpace(person))
                            {
                                <p class="message-signature"><strong>@person</strong>@(role is null ? null : $" · {role}")</p>
                            }
                        </div>
                    </div>
                </section>
                }
            }
            break;

        case "gallery":
            @if (items.Count > 0)
            {
                <section data-section="@block.SectionKey" class="shell section">
                    <div class="section-head"><p class="eyebrow">Campus life</p><h2>@block.Title</h2></div>
                    <div class="gallery-grid">
                        @foreach (var item in items.Take(8))
                        {
                            <figure><img src="@SectionJson.Item(item, "imageUrl")" alt="@SectionJson.Item(item, "alt")" loading="lazy" /></figure>
                        }
                    </div>
                </section>
            }
            break;

        case "contact":
            @* The console offers this section an address, a phone number, an email and a map,
               and none of the four had anywhere to go: the section fell through to the generic
               branch, which draws a heading and a paragraph and nothing else. Four fields that
               look like they work and do not. Blank fields fall back to the school's own
               details from Branding, so filling in nothing still gives a usable block. *@
            var contactAddress = SectionJson.GetString(json, "address") ?? Model.Branding.Address;
            var contactPhone = SectionJson.GetString(json, "phone") ?? Model.Branding.Phone;
            var contactEmail = SectionJson.GetString(json, "email") ?? Model.Branding.Email;
            var contactMap = MapEmbed.Read(
                SectionJson.GetString(json, "mapEmbedUrl") ?? Model.Branding.MapEmbedUrl,
                contactAddress);

            <section data-section="@block.SectionKey" class="shell section contact-block">
                <div>
                    <div class="section-head">
                        <h2>@(block.Title ?? "Get in touch")</h2>
                        @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                    </div>
                    <ul class="contact-meta">
                        @if (!string.IsNullOrWhiteSpace(contactAddress))
                        {
                            <li><span class="contact-meta__label">Address</span><span>@contactAddress</span></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(contactPhone))
                        {
                            <li>
                                <partial name="_Icon" model="@("phone")" />
                                <span class="contact-meta__label">Phone</span>
                                <a href="tel:@contactPhone">@contactPhone</a>
                            </li>
                        }
                        @if (!string.IsNullOrWhiteSpace(contactEmail))
                        {
                            <li>
                                <partial name="_Icon" model="@("mail")" />
                                <span class="contact-meta__label">Email</span>
                                <a href="mailto:@contactEmail">@contactEmail</a>
                            </li>
                        }
                    </ul>
                    @if (!string.IsNullOrWhiteSpace(block.ButtonText))
                    {
                        <a class="btn" href="@(block.ButtonLink ?? basePath + "/contact")">@block.ButtonText</a>
                    }
                </div>
                @if (contactMap is { Length: > 0 })
                {
                    <iframe class="map" src="@contactMap" loading="lazy" title="Campus map"></iframe>
                }
            </section>
            break;

        case "video":
            @* The section existed as a key, had fields in the console, and rendered nothing at
               all — whatever a school typed in went nowhere. A school has more than one film to
               show, so this takes a list; a single link in the section's own field is read as
               the first of them.

               Nothing loads from YouTube or Vimeo until somebody asks for it: the poster is a
               picture and a button, and the player is only built when it is clicked. A page
               that opens with three embedded players is three third-party pages loading, and
               every visitor tracked by them for a film nobody watched. *@
            var films = items.Count > 0
                ? items.Select(x => (
                    Title: SectionJson.Item(x, "title"),
                    Source: VideoEmbed.Read(SectionJson.Item(x, "videoUrl")),
                    Poster: SectionJson.Item(x, "posterUrl")))
                    .Where(x => x.Source is not null).ToList()
                : [(
                    Title: SectionJson.GetString(json, "caption"),
                    Source: VideoEmbed.Read(SectionJson.GetString(json, "videoUrl")),
                    Poster: SectionJson.GetString(json, "posterUrl"))];
            films = films.Where(x => x.Source is not null).ToList();

            // With no link this application can play there is nothing to build a player from.
            // A section whose whole purpose is a film, holding no film, is a title and a
            // subtitle over a blank band — "Video Section", and nothing to watch. It is worth
            // drawing only if the school also wrote something to read, in which case it falls
            // through to the ordinary rendering.
            if (films.Count == 0)
            {
                if (string.IsNullOrWhiteSpace(body)) { continue; }
                goto default;
            }

            @if (films.Count > 0)
            {
                <section data-section="@block.SectionKey" class="shell section">
                    <div class="section-head">
                        <h2>@(block.Title ?? "Watch")</h2>
                        @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                    </div>
                    <div class="video-grid @(films.Count == 1 ? "video-grid--single" : null)">
                        @foreach (var film in films)
                        {
                            var poster = film.Poster ?? film.Source!.PosterUrl;
                            <figure class="video-card">
                                @if (film.Source!.FileUrl is { Length: > 0 } file)
                                {
                                    <video controls preload="none" poster="@poster"><source src="@file" /></video>
                                }
                                else
                                {
                                    <button class="video-card__play" type="button"
                                            data-video-embed="@film.Source.EmbedUrl"
                                            aria-label="@("Play " + (film.Title ?? block.Title ?? "video"))">
                                        @if (!string.IsNullOrWhiteSpace(poster))
                                        {
                                            <img src="@poster" alt="" loading="lazy" />
                                        }
                                        <span class="video-card__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" /></svg>
                                        </span>
                                    </button>
                                }
                                @if (!string.IsNullOrWhiteSpace(film.Title))
                                {
                                    <figcaption>@film.Title</figcaption>
                                }
                            </figure>
                        }
                    </div>
                </section>
            }
            break;

        case "statistics":
            <section data-section="@block.SectionKey" class="shell stats-grid">
                <div class="stat"><strong>@(SectionJson.GetString(json, "students") ?? "—")</strong><span>Students</span></div>
                <div class="stat"><strong>@(SectionJson.GetString(json, "teachers") ?? "—")</strong><span>Teachers</span></div>
                <div class="stat"><strong>@(SectionJson.GetString(json, "placements") ?? "—")</strong><span>Placements</span></div>
                <div class="stat"><strong>@(SectionJson.GetString(json, "years") ?? "—")</strong><span>Years</span></div>
            </section>
            break;

        case "timings":
            @* The most looked-up fact on a school website, and the one every design left to a
               paragraph. A table because it is a table: two terms, several wings, one glance. *@
            <section data-section="@block.SectionKey" class="shell section">
                <div class="section-head">
                    <h2>@(block.Title ?? "School timings")</h2>
                    @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                </div>
                                @* A heading row with nothing under it reads as the page having failed rather
                   than as a table nobody has filled in yet. The rest of the section still
                   shows, so an intro written before the rows is not lost. *@
                @if (items.Count > 0)
                {
                <div class="table-scroll">
                    <table class="timings-table">
                        <thead>
                            <tr>
                                <th>Wing</th>
                                <th>@(SectionJson.GetString(json, "firstTerm") ?? "Summer")</th>
                                <th>@(SectionJson.GetString(json, "secondTerm") ?? "Winter")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in items)
                            {
                                <tr>
                                    <th scope="row">@SectionJson.Item(row, "wing")</th>
                                    <td>@SectionJson.Item(row, "summer")</td>
                                    <td>@SectionJson.Item(row, "winter")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                }
                @if (!string.IsNullOrWhiteSpace(block.Description))
                {
                    <p class="table-note">@RichText.ToPlainText(block.Description)</p>
                }
            </section>
            break;

        case "crest":
            @* A school explains what it stands for by reading its own crest. Each symbol is a
               line, and the whole point is that they are read in order. *@
            @* The crest beside its own reading, with the motto over the top of both.

               The layout lives on an inner element rather than on the section itself. As a
               section it inherited whichever grid the design imposes — and Bulletin's puts
               every child in its second column, so the crest and the words stacked on top of
               one another with the first column left empty, and on a narrow screen the whole
               thing collapsed to a 78px ribbon of text a word wide. A design can place this
               block; it cannot reach inside it. *@
            {
                // A row carrying a picture and no words is not one of the crest's symbols — it is
                // the crest. Schools put their badge in the first icon field they meet, which is
                // the 40px pictogram beside a symbol's name, and it came out as a 24px dot with an
                // empty line of text next to it. So: rows with nothing to read are not drawn, and
                // if the section has no crest of its own the first of those pictures becomes it.
                Func<System.Text.Json.JsonElement, bool> hasWords = row =>
                    !string.IsNullOrWhiteSpace(SectionJson.Item(row, "symbol"))
                    || !string.IsNullOrWhiteSpace(SectionJson.Item(row, "meaning"));

                var readings = items.Where(hasWords).ToList();
                var crestMark = block.ImageUrl;
                if (string.IsNullOrWhiteSpace(crestMark))
                {
                    crestMark = items.Where(x => !hasWords(x))
                        .Select(x => SectionJson.Item(x, "iconUrl"))
                        .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
                }

            <section data-section="@block.SectionKey" class="shell section crest-section">
                <div class="crest-section__inner">
                    <div class="section-head crest-section__head">
                        <h2>@(block.Title ?? "Our crest")</h2>
                        @if (!string.IsNullOrWhiteSpace(intro)) { <p class="motto">@intro</p> }
                    </div>
                    <div class="crest-layout">
                        @if (!string.IsNullOrWhiteSpace(crestMark))
                        {
                            <figure class="crest-section__mark"><img src="@crestMark" alt="@(block.Title ?? "School crest")" loading="lazy" /></figure>
                        }
                        @if (readings.Count > 0)
                        {
                        <ul class="crest-meanings">
                            @foreach (var symbol in readings)
                            {
                                var badge = SectionJson.Item(symbol, "iconUrl");
                                <li>
                                    <span class="crest-badge">
                                        @if (!string.IsNullOrWhiteSpace(badge))
                                        {
                                            <img src="@badge" alt="" loading="lazy" />
                                        }
                                    </span>
                                    <span class="crest-meanings__text">
                                        <strong>@SectionJson.Item(symbol, "symbol")</strong>
                                        <span>@SectionJson.Item(symbol, "meaning")</span>
                                    </span>
                                </li>
                            }
                        </ul>
                        }
                    </div>
                </div>
            </section>
            }
            break;

        case "alumni":
            <section data-section="@block.SectionKey" class="shell section">
                <div class="section-head">
                    <h2>@(block.Title ?? "Notable alumni")</h2>
                    @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                </div>
                <div class="alumni-grid">
                    @foreach (var person in items)
                    {
                        <article>
                            @if (SectionJson.Item(person, "imageUrl") is { Length: > 0 } portrait)
                            {
                                <img src="@portrait" alt="@SectionJson.Item(person, "name")" loading="lazy" />
                            }
                            <h3>@SectionJson.Item(person, "name")</h3>
                            @if (SectionJson.Item(person, "role") is { Length: > 0 } role) { <p class="alumni-role">@role</p> }
                            @if (SectionJson.Item(person, "batch") is { Length: > 0 } batch) { <p class="alumni-batch">Class of @batch</p> }
                        </article>
                    }
                </div>
            </section>
            break;

        case "staff_list":
            @* Forty names with designations. As cards this is four screens of scrolling; as a
               table it is one, and it can be searched with the browser's own find. *@
            <section data-section="@block.SectionKey" class="shell section">
                <div class="section-head">
                    <h2>@(block.Title ?? "Staff list")</h2>
                    @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                </div>
                @* Where the names come from.

                   A school keeps its staff under People — that is where the console asks for a
                   name, a designation and a qualification, which is exactly this table. This
                   section used to read only the rows typed into its own configuration, so a
                   school that had entered its whole staff in the obvious place saw a heading
                   with nothing under it.

                   Rows typed into the section still win, because a school that typed them meant
                   them. With none, the People list fills the table. *@
                @{
                    var staffRows = items.Count > 0
                        ? items.Select(x => (
                            Name: SectionJson.Item(x, "name"),
                            Designation: SectionJson.Item(x, "designation"),
                            Qualification: SectionJson.Item(x, "qualification"))).ToList()
                        : faculty.Select(x => (
                            Name: (string?)x.FullName,
                            Designation: x.Designation,
                            Qualification: x.Qualification)).ToList();
                }
                @* A heading row with nothing under it reads as the page having failed rather
                   than as a table nobody has filled in yet. The rest of the section still
                   shows, so an intro written before the rows is not lost. *@
                @if (staffRows.Count > 0)
                {
                <div class="table-scroll">
                    <table class="staff-table">
                        <thead>
                            <tr><th>#</th><th>Name</th><th>Designation</th><th>Qualification</th></tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < staffRows.Count; i++)
                            {
                                <tr>
                                    <td>@(i + 1)</td>
                                    <th scope="row">@staffRows[i].Name</th>
                                    <td>@staffRows[i].Designation</td>
                                    <td>@staffRows[i].Qualification</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                }
            </section>
            break;

        case "facilities":
            <section data-section="@block.SectionKey" class="shell section">
                <div class="section-head">
                    <h2>@(block.Title ?? "Facilities")</h2>
                    @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                </div>
                <div class="facility-list">
                    @foreach (var facility in items)
                    {
                        <article>
                            @if (SectionJson.Item(facility, "imageUrl") is { Length: > 0 } photo)
                            {
                                <img src="@photo" alt="@SectionJson.Item(facility, "title")" loading="lazy" />
                            }
                            <div>
                                <h3>@SectionJson.Item(facility, "title")</h3>
                                <p>@SectionJson.Item(facility, "description")</p>
                            </div>
                        </article>
                    }
                </div>
            </section>
            break;

        case "founder":
            @* A portrait and a dated sequence. The dates carry the meaning, so they lead. *@
            <section data-section="@block.SectionKey" class="shell section founder-section">
                <div class="founder-section__who">
                    @if (!string.IsNullOrWhiteSpace(block.ImageUrl))
                    {
                        <img src="@block.ImageUrl" alt="@(SectionJson.GetString(json, "name") ?? block.Title)" loading="lazy" />
                    }
                    <h2>@(block.Title ?? "Founder &amp; history")</h2>
                    @if (SectionJson.GetString(json, "name") is { Length: > 0 } founderName)
                    {
                        <p class="founder-name">@founderName</p>
                    }
                    @if (SectionJson.GetString(json, "lifespan") is { Length: > 0 } lifespan)
                    {
                        <p class="founder-dates">@lifespan</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(block.Description))
                    {
                        <div class="section-body">@Html.Raw(block.Description)</div>
                    }
                </div>
                @if (items.Count > 0)
                {
                    <ol class="founder-timeline">
                        @foreach (var moment in items)
                        {
                            <li>
                                <time>@SectionJson.Item(moment, "year")</time>
                                <div>
                                    <h3>@SectionJson.Item(moment, "title")</h3>
                                    <p>@SectionJson.Item(moment, "description")</p>
                                </div>
                            </li>
                        }
                    </ol>
                }
            </section>
            break;

        case "downloads":
            @* Format and size stated, because a parent on a phone deserves to know what a link
               is about to cost them before they tap it. *@
            <section data-section="@block.SectionKey" class="shell section">
                <div class="section-head">
                    <h2>@(block.Title ?? "Downloads")</h2>
                    @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                </div>
                                @* A heading row with nothing under it reads as the page having failed rather
                   than as a table nobody has filled in yet. The rest of the section still
                   shows, so an intro written before the rows is not lost. *@
                @if (items.Count > 0)
                {
                <div class="table-scroll">
                    <table class="downloads-table">
                        <thead><tr><th>Document</th><th>Format</th><th>Size</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var file in items)
                            {
                                var href = SectionJson.Item(file, "fileUrl");
                                <tr>
                                    <th scope="row">@SectionJson.Item(file, "title")</th>
                                    <td>@(SectionJson.Item(file, "format") ?? "PDF")</td>
                                    <td>@SectionJson.Item(file, "size")</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(href))
                                        {
                                            <a class="btn btn-sm" href="@href" download>Download</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                }
            </section>
            break;

        default:
            <section data-section="@block.SectionKey" class="shell section">
                <div class="section-head">
                    @if (!string.IsNullOrWhiteSpace(block.Title)) { <h2>@block.Title</h2> }
                    @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                </div>
                @if (!string.IsNullOrWhiteSpace(block.ImageUrl))
                {
                    <img class="section-image" src="@block.ImageUrl" alt="@block.Title" loading="lazy" />
                }
                @if (!string.IsNullOrWhiteSpace(block.Description))
                {
                    <div class="section-body">@Html.Raw(block.Description)</div>
                }
                @if (items.Count > 0)
                {
                    @* Every section without a renderer of its own lands here: courses,
                       departments, events, achievements, testimonials, partners. It used to
                       draw a heading and a paragraph and nothing else — so the picture a school
                       had uploaded against each row never appeared, a testimonial showed no
                       name because testimonials carry "name" and not "title", and the page
                       address on a course led nowhere because no link was ever drawn. *@
                    <div class="card-grid">
                        @foreach (var item in items.Take(8))
                        {
                            var cardImage = SectionJson.Item(item, "imageUrl")
                                ?? SectionJson.Item(item, "logoUrl")
                                ?? SectionJson.Item(item, "photoUrl");
                            var cardTitle = SectionJson.Item(item, "title")
                                ?? SectionJson.Item(item, "name");
                            var cardBody = SectionJson.Item(item, "description")
                                ?? SectionJson.Item(item, "quote")
                                ?? SectionJson.Item(item, "summary");
                            var cardMeta = SectionJson.Item(item, "date")
                                ?? SectionJson.Item(item, "year")
                                ?? SectionJson.Item(item, "location")
                                ?? SectionJson.Item(item, "role");
                            // A page address typed as "/departments" has to keep the path this
                            // website is served under, or the link lands on another school's page
                            // — or on nothing. An address to somewhere else is left alone.
                            var cardHref = SectionJson.Item(item, "url");
                            var cardLink = cardHref is { Length: > 0 } && cardHref.StartsWith('/')
                                ? basePath + cardHref
                                : cardHref;

                            <article>
                                @if (!string.IsNullOrWhiteSpace(cardImage))
                                {
                                    <img src="@cardImage" alt="@cardTitle" loading="lazy" />
                                }
                                <div class="card-grid__text">
                                    @if (!string.IsNullOrWhiteSpace(cardMeta)) { <p class="card-meta">@cardMeta</p> }
                                    @if (!string.IsNullOrWhiteSpace(cardTitle))
                                    {
                                        <h3>
                                            @if (!string.IsNullOrWhiteSpace(cardLink))
                                            {
                                                <a href="@cardLink">@cardTitle</a>
                                            }
                                            else
                                            {
                                                @cardTitle
                                            }
                                        </h3>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(cardBody)) { <p>@cardBody</p> }
                                </div>
                            </article>
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(block.ButtonText))
                {
                    <p class="section-more">
                        <a class="btn" href="@(block.ButtonLink ?? basePath + "/contact")">@block.ButtonText</a>
                    </p>
                }
            </section>
            break;
    }
}
