@model PublicWebsiteDto
@using Cms.Application.DTOs.SchoolContent
@using Cms.Web.Helpers
@{
    // Every design renders a handful of sections in its own bespoke way and used to ignore the
    // rest, so most of what the console offers to edit never appeared on the website at all —
    // the principal's message, the chairman's message, announcements, and a dozen more. The
    // design still owns its own blocks; everything else is rendered here, in the order the
    // console shows, so nothing an editor fills in is silently invisible.
    var handled = (ViewData["renderedSections"] as string[] ?? []).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var basePath = Model.BasePath;
    var news = ViewData["News"] as IReadOnlyList<NewsArticleDto> ?? [];
    var events = ViewData["Events"] as IReadOnlyList<SchoolEventDto> ?? [];

    var remaining = Model.HomeSections
        .Where(s => !handled.Contains(s.SectionKey))
        .ToList();
}

@foreach (var block in remaining)
{
    var json = SectionJson.Parse(block.JsonData);
    var items = SectionJson.GetArray(json, "items").ToList();
    var body = RichText.ToPlainText(block.Description);
    var intro = SectionJson.GetString(json, "intro") ?? block.SubTitle;

    switch (block.SectionKey)
    {
        case "announcements":
        case "latest_news":
            @if (news.Count > 0 || items.Count > 0)
            {
                <section data-section="@block.SectionKey" class="shell section">
                    <div class="section-head">
                        <p class="eyebrow">Announcements</p>
                        <h2>@(block.Title ?? "News and notices")</h2>
                        @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                    </div>
                    <div class="card-grid">
                        @if (news.Count > 0)
                        {
                            @foreach (var item in news.Take(3))
                            {
                                <article>
                                    <p class="eyebrow">@item.Category</p>
                                    <h3><a href="@(basePath)/news/@item.Key">@item.Headline</a></h3>
                                    @if (!string.IsNullOrWhiteSpace(item.Summary)) { <p>@item.Summary</p> }
                                </article>
                            }
                        }
                        else
                        {
                            @foreach (var item in items.Take(3))
                            {
                                <article>
                                    <h3>@SectionJson.Item(item, "title")</h3>
                                    <p>@SectionJson.Item(item, "summary")</p>
                                </article>
                            }
                        }
                    </div>
                    <p class="section-more"><a class="btn btn-ghost" href="@(basePath)/news">All news and notices</a></p>
                </section>
            }
            break;

        case "upcoming_events":
            @if (events.Count > 0 || items.Count > 0)
            {
                <section data-section="@block.SectionKey" class="shell section">
                    <div class="section-head">
                        <p class="eyebrow">What's on</p>
                        <h2>@(block.Title ?? "Upcoming events")</h2>
                        @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                    </div>
                    <div class="card-grid">
                        @if (events.Count > 0)
                        {
                            @foreach (var item in events.Take(3))
                            {
                                <article>
                                    <p class="eyebrow">@(item.StartsOn?.ToString("dd MMM yyyy"))</p>
                                    <h3><a href="@(basePath)/events/@item.Key">@item.Title</a></h3>
                                    @if (!string.IsNullOrWhiteSpace(item.Venue)) { <p>@item.Venue</p> }
                                </article>
                            }
                        }
                        else
                        {
                            @foreach (var item in items.Take(3))
                            {
                                <article>
                                    <h3>@SectionJson.Item(item, "title")</h3>
                                    <p>@SectionJson.Item(item, "location")</p>
                                </article>
                            }
                        }
                    </div>
                    <p class="section-more"><a class="btn btn-ghost" href="@(basePath)/events">All events</a></p>
                </section>
            }
            break;

        case "principal":
        case "chairman":
        case "director":
        case "manager":
            {
                var person = SectionJson.GetString(json, "personName");
                var role = SectionJson.GetString(json, "designation");
                var quote = SectionJson.GetString(json, "quote");
                <section data-section="@block.SectionKey" class="shell section message-section">
                    <div class="section-head">
                        <p class="eyebrow">@(role ?? block.Title)</p>
                        <h2>@(block.Title ?? role)</h2>
                    </div>
                    <div class="message-block">
                        @if (!string.IsNullOrWhiteSpace(block.ImageUrl))
                        {
                            <img class="message-portrait" src="@block.ImageUrl" alt="@person" loading="lazy" />
                        }
                        <div>
                            @if (!string.IsNullOrWhiteSpace(quote)) { <blockquote>@quote</blockquote> }
                            @if (!string.IsNullOrWhiteSpace(block.Description)) { @Html.Raw(block.Description) }
                            @if (!string.IsNullOrWhiteSpace(person))
                            {
                                <p class="message-signature"><strong>@person</strong>@(role is null ? null : $" · {role}")</p>
                            }
                        </div>
                    </div>
                </section>
            }
            break;

        case "gallery":
            @if (items.Count > 0)
            {
                <section data-section="@block.SectionKey" class="shell section">
                    <div class="section-head"><p class="eyebrow">Campus life</p><h2>@block.Title</h2></div>
                    <div class="gallery-grid">
                        @foreach (var item in items.Take(8))
                        {
                            <figure><img src="@SectionJson.Item(item, "imageUrl")" alt="@SectionJson.Item(item, "alt")" loading="lazy" /></figure>
                        }
                    </div>
                </section>
            }
            break;

        case "video":
            @* The section existed as a key, had fields in the console, and rendered nothing at
               all — whatever a school typed in went nowhere. A school has more than one film to
               show, so this takes a list; a single link in the section's own field is read as
               the first of them.

               Nothing loads from YouTube or Vimeo until somebody asks for it: the poster is a
               picture and a button, and the player is only built when it is clicked. A page
               that opens with three embedded players is three third-party pages loading, and
               every visitor tracked by them for a film nobody watched. *@
            var films = items.Count > 0
                ? items.Select(x => (
                    Title: SectionJson.Item(x, "title"),
                    Source: VideoEmbed.Read(SectionJson.Item(x, "videoUrl")),
                    Poster: SectionJson.Item(x, "posterUrl")))
                    .Where(x => x.Source is not null).ToList()
                : [(
                    Title: SectionJson.GetString(json, "caption"),
                    Source: VideoEmbed.Read(SectionJson.GetString(json, "videoUrl")),
                    Poster: SectionJson.GetString(json, "posterUrl"))];
            films = films.Where(x => x.Source is not null).ToList();

            // With no link this application can play there is nothing to build a player from,
            // but the section is still a heading and a paragraph a school wrote. It falls
            // through to the ordinary rendering rather than vanishing.
            if (films.Count == 0) { goto default; }

            @if (films.Count > 0)
            {
                <section data-section="@block.SectionKey" class="shell section">
                    <div class="section-head">
                        <h2>@(block.Title ?? "Watch")</h2>
                        @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                    </div>
                    <div class="video-grid @(films.Count == 1 ? "video-grid--single" : null)">
                        @foreach (var film in films)
                        {
                            var poster = film.Poster ?? film.Source!.PosterUrl;
                            <figure class="video-card">
                                @if (film.Source!.FileUrl is { Length: > 0 } file)
                                {
                                    <video controls preload="none" poster="@poster"><source src="@file" /></video>
                                }
                                else
                                {
                                    <button class="video-card__play" type="button"
                                            data-video-embed="@film.Source.EmbedUrl"
                                            aria-label="@("Play " + (film.Title ?? block.Title ?? "video"))">
                                        @if (!string.IsNullOrWhiteSpace(poster))
                                        {
                                            <img src="@poster" alt="" loading="lazy" />
                                        }
                                        <span class="video-card__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" /></svg>
                                        </span>
                                    </button>
                                }
                                @if (!string.IsNullOrWhiteSpace(film.Title))
                                {
                                    <figcaption>@film.Title</figcaption>
                                }
                            </figure>
                        }
                    </div>
                </section>
            }
            break;

        case "statistics":
            <section data-section="@block.SectionKey" class="shell stats-grid">
                <div class="stat"><strong>@(SectionJson.GetString(json, "students") ?? "—")</strong><span>Students</span></div>
                <div class="stat"><strong>@(SectionJson.GetString(json, "teachers") ?? "—")</strong><span>Teachers</span></div>
                <div class="stat"><strong>@(SectionJson.GetString(json, "placements") ?? "—")</strong><span>Placements</span></div>
                <div class="stat"><strong>@(SectionJson.GetString(json, "years") ?? "—")</strong><span>Years</span></div>
            </section>
            break;

        case "timings":
            @* The most looked-up fact on a school website, and the one every design left to a
               paragraph. A table because it is a table: two terms, several wings, one glance. *@
            <section data-section="@block.SectionKey" class="shell section">
                <div class="section-head">
                    <h2>@(block.Title ?? "School timings")</h2>
                    @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                </div>
                <div class="table-scroll">
                    <table class="timings-table">
                        <thead>
                            <tr>
                                <th>Wing</th>
                                <th>@(SectionJson.GetString(json, "firstTerm") ?? "Summer")</th>
                                <th>@(SectionJson.GetString(json, "secondTerm") ?? "Winter")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in items)
                            {
                                <tr>
                                    <th scope="row">@SectionJson.Item(row, "wing")</th>
                                    <td>@SectionJson.Item(row, "summer")</td>
                                    <td>@SectionJson.Item(row, "winter")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!string.IsNullOrWhiteSpace(block.Description))
                {
                    <p class="table-note">@RichText.ToPlainText(block.Description)</p>
                }
            </section>
            break;

        case "crest":
            @* A school explains what it stands for by reading its own crest. Each symbol is a
               line, and the whole point is that they are read in order. *@
            <section data-section="@block.SectionKey" class="shell section crest-section">
                @if (!string.IsNullOrWhiteSpace(block.ImageUrl))
                {
                    <figure class="crest-section__mark"><img src="@block.ImageUrl" alt="@(block.Title ?? "School crest")" loading="lazy" /></figure>
                }
                <div>
                    <div class="section-head">
                        <h2>@(block.Title ?? "Our crest")</h2>
                        @if (!string.IsNullOrWhiteSpace(intro)) { <p class="motto">@intro</p> }
                    </div>
                    <dl class="crest-meanings">
                        @foreach (var symbol in items)
                        {
                            <div>
                                <dt>@SectionJson.Item(symbol, "symbol")</dt>
                                <dd>@SectionJson.Item(symbol, "meaning")</dd>
                            </div>
                        }
                    </dl>
                </div>
            </section>
            break;

        case "alumni":
            <section data-section="@block.SectionKey" class="shell section">
                <div class="section-head">
                    <h2>@(block.Title ?? "Notable alumni")</h2>
                    @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                </div>
                <div class="alumni-grid">
                    @foreach (var person in items)
                    {
                        <article>
                            @if (SectionJson.Item(person, "imageUrl") is { Length: > 0 } portrait)
                            {
                                <img src="@portrait" alt="@SectionJson.Item(person, "name")" loading="lazy" />
                            }
                            <h3>@SectionJson.Item(person, "name")</h3>
                            @if (SectionJson.Item(person, "role") is { Length: > 0 } role) { <p class="alumni-role">@role</p> }
                            @if (SectionJson.Item(person, "batch") is { Length: > 0 } batch) { <p class="alumni-batch">Class of @batch</p> }
                        </article>
                    }
                </div>
            </section>
            break;

        case "staff_list":
            @* Forty names with designations. As cards this is four screens of scrolling; as a
               table it is one, and it can be searched with the browser's own find. *@
            <section data-section="@block.SectionKey" class="shell section">
                <div class="section-head">
                    <h2>@(block.Title ?? "Staff list")</h2>
                    @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                </div>
                <div class="table-scroll">
                    <table class="staff-table">
                        <thead>
                            <tr><th>#</th><th>Name</th><th>Designation</th><th>Qualification</th></tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < items.Count; i++)
                            {
                                <tr>
                                    <td>@(i + 1)</td>
                                    <th scope="row">@SectionJson.Item(items[i], "name")</th>
                                    <td>@SectionJson.Item(items[i], "designation")</td>
                                    <td>@SectionJson.Item(items[i], "qualification")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
            break;

        case "facilities":
            <section data-section="@block.SectionKey" class="shell section">
                <div class="section-head">
                    <h2>@(block.Title ?? "Facilities")</h2>
                    @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                </div>
                <div class="facility-list">
                    @foreach (var facility in items)
                    {
                        <article>
                            @if (SectionJson.Item(facility, "imageUrl") is { Length: > 0 } photo)
                            {
                                <img src="@photo" alt="@SectionJson.Item(facility, "title")" loading="lazy" />
                            }
                            <div>
                                <h3>@SectionJson.Item(facility, "title")</h3>
                                <p>@SectionJson.Item(facility, "description")</p>
                            </div>
                        </article>
                    }
                </div>
            </section>
            break;

        case "founder":
            @* A portrait and a dated sequence. The dates carry the meaning, so they lead. *@
            <section data-section="@block.SectionKey" class="shell section founder-section">
                <div class="founder-section__who">
                    @if (!string.IsNullOrWhiteSpace(block.ImageUrl))
                    {
                        <img src="@block.ImageUrl" alt="@(SectionJson.GetString(json, "name") ?? block.Title)" loading="lazy" />
                    }
                    <h2>@(block.Title ?? "Founder &amp; history")</h2>
                    @if (SectionJson.GetString(json, "name") is { Length: > 0 } founderName)
                    {
                        <p class="founder-name">@founderName</p>
                    }
                    @if (SectionJson.GetString(json, "lifespan") is { Length: > 0 } lifespan)
                    {
                        <p class="founder-dates">@lifespan</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(block.Description))
                    {
                        <div class="section-body">@Html.Raw(block.Description)</div>
                    }
                </div>
                @if (items.Count > 0)
                {
                    <ol class="founder-timeline">
                        @foreach (var moment in items)
                        {
                            <li>
                                <time>@SectionJson.Item(moment, "year")</time>
                                <div>
                                    <h3>@SectionJson.Item(moment, "title")</h3>
                                    <p>@SectionJson.Item(moment, "description")</p>
                                </div>
                            </li>
                        }
                    </ol>
                }
            </section>
            break;

        case "downloads":
            @* Format and size stated, because a parent on a phone deserves to know what a link
               is about to cost them before they tap it. *@
            <section data-section="@block.SectionKey" class="shell section">
                <div class="section-head">
                    <h2>@(block.Title ?? "Downloads")</h2>
                    @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                </div>
                <div class="table-scroll">
                    <table class="downloads-table">
                        <thead><tr><th>Document</th><th>Format</th><th>Size</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var file in items)
                            {
                                var href = SectionJson.Item(file, "fileUrl");
                                <tr>
                                    <th scope="row">@SectionJson.Item(file, "title")</th>
                                    <td>@(SectionJson.Item(file, "format") ?? "PDF")</td>
                                    <td>@SectionJson.Item(file, "size")</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(href))
                                        {
                                            <a class="btn btn-sm" href="@href" download>Download</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
            break;

        default:
            <section data-section="@block.SectionKey" class="shell section">
                <div class="section-head">
                    @if (!string.IsNullOrWhiteSpace(block.Title)) { <h2>@block.Title</h2> }
                    @if (!string.IsNullOrWhiteSpace(intro)) { <p>@intro</p> }
                </div>
                @if (!string.IsNullOrWhiteSpace(block.ImageUrl))
                {
                    <img class="section-image" src="@block.ImageUrl" alt="@block.Title" loading="lazy" />
                }
                @if (!string.IsNullOrWhiteSpace(block.Description))
                {
                    <div class="section-body">@Html.Raw(block.Description)</div>
                }
                @if (items.Count > 0)
                {
                    <div class="card-grid">
                        @foreach (var item in items.Take(8))
                        {
                            <article>
                                <h3>@SectionJson.Item(item, "title")</h3>
                                <p>@(SectionJson.Item(item, "description") ?? SectionJson.Item(item, "quote") ?? SectionJson.Item(item, "summary"))</p>
                            </article>
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(block.ButtonText))
                {
                    <p class="section-more">
                        <a class="btn" href="@(block.ButtonLink ?? basePath + "/contact")">@block.ButtonText</a>
                    </p>
                }
            </section>
            break;
    }
}
